class Point(local x_initial := 1)
    x := 1
    y := 2


    x = x_initial

    int sum()
        return x + y

class ShiftedPoint()
    point := Point()
    offset := 1

    int sum()
        return point.sum() + offset

a := Point()
a.x = 1
a.y = 2
b := Point(1)
shifted := ShiftedPoint()

left := [1, 2, 3]
right := [1, 2, 3]

println(a == b)
println(left == right)
println(shifted.sum())
