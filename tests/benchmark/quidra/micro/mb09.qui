// MB-09 - Statistics: two-pass (stable) moments, Pearson correlation and a
// 64-bin histogram. No statistics library, no Welford substitution.
// Methodology 06 section 5.2 program modes: argv[1] in {once, steady}, argv[2] = K.
cli args
    string mode = argument(default = "once")
    int iterations = argument(default = 7)

// Lehmer / MINSTD generator, frozen for every language in the suite.
class Lcg
    int state

    construct(int seed)
        state = seed

    int next_int()
        state = (48271 * state) % 2147483647
        return state

    float next_unit()
        return float(next_int()) / 2147483647.0

class Result
    float mean
    float var
    float sd
    float mn
    float mx
    float mad
    float pearson
    int hist_chk

// The whole workload body, generation included (methodology 06 section 4, MB-09).
Result workload()
    int n = 2000000
    int rounds = 30
    float count = 2000000.0
    float scale = 0.64
    Lcg g = Lcg(20269917)
    float[] x = array(n, fill = 0.0)
    float[] y = array(n, fill = 0.0)
    for i in range(n)
        x[i] = g.next_unit() * 100.0
    for i in range(n)
        y[i] = g.next_unit() * 100.0

    float mean = 0.0
    float var = 0.0
    float sd = 0.0
    float mn = 0.0
    float mx = 0.0
    float mad = 0.0
    float pearson = 0.0
    int hist_chk = 0

    for r in range(rounds)
        x[r] = x[r] + 1.0e-9

        float s = 0.0
        mn = x[0]
        mx = x[0]
        for i in range(n)
            float v = x[i]
            s = s + v
            if v < mn
                mn = v
            if v > mx
                mx = v
        mean = s / count

        float sq = 0.0
        float ad = 0.0
        for i in range(n)
            float d = x[i] - mean
            sq = sq + d * d
            if d < 0.0
                ad = ad + (0.0 - d)
            else
                ad = ad + d
        var = sq / count
        sd = math.sqrt(var)
        mad = ad / count

        float sy = 0.0
        for i in range(n)
            sy = sy + y[i]
        float meany = sy / count

        float sxy = 0.0
        float sxx = 0.0
        float syy = 0.0
        for i in range(n)
            float dx = x[i] - mean
            float dy = y[i] - meany
            sxy = sxy + dx * dy
            sxx = sxx + dx * dx
            syy = syy + dy * dy
        pearson = sxy / math.sqrt(sxx * syy)

        int[] hist = array(64, fill = 0)
        for i in range(n)
            int b = math.floor(x[i] * scale)
            if b < 0
                b = 0
            if b > 63
                b = 63
            hist[b] = hist[b] + 1
        hist_chk = 0
        for b in range(64)
            hist_chk = hist_chk + (b + 1) * hist[b]

    Result result
    result.mean = mean
    result.var = var
    result.sd = sd
    result.mn = mn
    result.mx = mx
    result.mad = mad
    result.pearson = pearson
    result.hist_chk = hist_chk
    return result

Result timed(int index)
    time.Instant start = time.now()
    Result result = workload()
    time.Duration elapsed = time.since(start)
    int elapsed_ns = math.round(elapsed.seconds() * 1000000000.0)
    print("ITER {index} {elapsed_ns}")
    io.flush()
    return result

Result result
if args.mode == "steady"
    int k = math.max(args.iterations, 1)
    result = timed(0)
    for i in range(1, k)
        result = timed(i)
else
    result = workload()

print("MB09 mean={result.mean:sig=17} var={result.var:sig=17} sd={result.sd:sig=17} min={result.mn:sig=17} max={result.mx:sig=17} mad={result.mad:sig=17} pearson={result.pearson:sig=17} hist_chk={result.hist_chk}")
