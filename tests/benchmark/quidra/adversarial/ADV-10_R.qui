print("ADV-START")
io.flush()
string read_input_line()
    string | none | error line = input()
    match line
        string text
            return text
        none
            process.exit(2)
        error problem
            process.exit(2)
int[] values = [10, 20, 30, 40, 50]
int index = int.parse(read_input_line())
int element = values[index]
print("OBS=ELEM:{element}")
io.flush()
print("ADV-END")
io.flush()
