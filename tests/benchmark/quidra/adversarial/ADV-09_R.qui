print("ADV-START")
io.flush()
string read_input_line()
    string line = ""
    void | error read = scan(&line)
    match read
        void
            return line
        error problem
            process.exit(2)
int[] values = [10, 20, 30, 40, 50]
int index = int.parse(read_input_line())
int element = values[index]
print("OBS=ELEM:{element}")
io.flush()
print("ADV-END")
io.flush()
