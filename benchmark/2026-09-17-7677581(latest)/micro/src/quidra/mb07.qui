// MB-07 sorting: bottom-up iterative merge sort, ascending, stable, ping-pong buffers.
//
// Mode selection (methodology 06 section 5.2). Quidra's `cli` module has no
// OPTIONAL positional argument: `argument()` is positional but mandatory (a bare
// `./BIN` then exits with CLI status 2, which would break the frozen `once`
// recipe), and `option(default = ...)` is optional but named. The optional form
// is the one that preserves section 5.2's semantics, so the mode is spelled
// `--mode steady --iters K` instead of `argv[1] argv[2]`.
//
// Section 5.2 also requires each ITER line to be flushed immediately, and
// Quidra v0.1 cannot do that: `print` lowers to C `puts` on block-buffered
// stdout (quidra/src/llvm_backend.cpp:2195, :2202, :2209; `declare i32 @puts`
// at :2829) and the standard library exposes no flush call. Measured: this
// program run in steady mode with stdout redirected to a file and SIGKILLed
// after three iterations had completed produced 0 bytes of output. Section
// 5.4's partial-retention rule (rule 1) is therefore inert for this
// configuration; a steady process stopped at the timeout falls to rule 2.

cli args
    string mode = option(default = "once")
    int iters = option(default = 7)

void merge_pass(const int[] &source, int[] &destination, int count, int width)
    int lo = 0
    while lo < count
        int mid = lo + width
        if mid > count
            mid = count
        int hi = lo + 2 * width
        if hi > count
            hi = count
        int i = lo
        int j = mid
        int k = lo
        while i < mid and j < hi
            if source[i] <= source[j]
                destination[k] = source[i]
                i += 1
            else
                destination[k] = source[j]
                j += 1
            k += 1
        while i < mid
            destination[k] = source[i]
            i += 1
            k += 1
        while j < hi
            destination[k] = source[j]
            j += 1
            k += 1
        lo += 2 * width
    return

void merge_sort(int[] &values, int[] &buffer, int count)
    // `in_values` is true while the live sequence is held by `values`.
    bool in_values = true
    int width = 1
    while width < count
        if in_values
            merge_pass(&values, &buffer, count, width)
        else
            merge_pass(&buffer, &values, count, width)
        in_values = not in_values
        width *= 2
    if not in_values
        // Whole-array value assignment: Quidra's ordinary bulk copy, the
        // counterpart of std::copy / copy_from_slice / System.arraycopy.
        values = buffer
    return

class Result
    int total = 0
    int checked_sum = 0
    int inversions = 0

Result workload()
    const int count = 2000000
    const int rounds = 4
    int state = 20267917

    int[] source = array(count, fill = 0)
    for i in range(0, count)
        state = (state * 48271) % 2147483647
        source[i] = state

    int[] buffer = array(count, fill = 0)
    int total = 0
    int checked_sum = 0
    int inversions = 0

    for round in range(0, rounds)
        source[round] += 1
        int[] values = source
        merge_sort(&values, &buffer, count)

        int check = 0
        for i in range(0, count)
            check = (check * 31 + values[i] % 1000003) % 1000003
        total = (total * 7 + check) % 1000003

        checked_sum = 0
        for i in range(0, count)
            checked_sum += values[i]

        for i in range(1, count)
            if values[i - 1] > values[i]
                inversions += 1

    return Result(total = total, checked_sum = checked_sum, inversions = inversions)

Result out = Result()
if args.mode == "steady"
    for k in range(0, args.iters)
        time.Instant started = time.now()
        out = workload()
        time.Duration elapsed = time.since(started)
        int nanoseconds = math.floor(elapsed.seconds() * 1000000000.0)
        print("ITER {k} {nanoseconds}")
else
    out = workload()
print("MB07 {out.total} {out.checked_sum} {out.inversions}")
