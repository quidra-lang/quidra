class Point
    int x = 1
    int y = 2

    construct(int first = 1)
        x = first

    int sum()
        return x + y

class ShiftedPoint
    Point point = Point()
    int offset = 1

    int sum()
        return point.sum() + offset

Point a
Point b = Point(1)
ShiftedPoint shifted

int[] left = [1, 2, 3]
int[] right = [1, 2, 3]

print(a == b)
print(left == right)
print(shifted.sum())
