// MB-02 - Factorial: recompute k! mod M from scratch for every k.
//
// Mode selection (methodology 06 section 5.2). Quidra's `cli` module has no
// OPTIONAL positional argument: `argument()` is positional but mandatory (a bare
// `./BIN` then exits with CLI status 2, which would break the frozen `once`
// recipe), and `option(default = ...)` is optional but named. The optional form
// is the one that preserves section 5.2's semantics, so the mode is spelled
// `--mode steady --iters K` instead of `argv[1] argv[2]`.
//
// Section 5.2 also requires each ITER line to be flushed immediately, and
// Quidra v0.1 cannot do that: `print` lowers to C `puts` on block-buffered
// stdout (quidra/src/llvm_backend.cpp:2195, :2202, :2209; `declare i32 @puts`
// at :2829) and the standard library exposes no flush call. Measured: this
// program run in steady mode with stdout redirected to a file and SIGKILLed
// after three iterations had completed produced 0 bytes of output. Section
// 5.4's partial-retention rule (rule 1) is therefore inert for this
// configuration; a steady process stopped at the timeout falls to rule 2.

cli args
    string mode = option(default = "once")
    int iters = option(default = 7)

int workload()
    const int M = 1000003
    const int N = 20000

    int sum = 0
    for k in range(1, N + 1)
        int f = 1
        for j in range(2, k + 1)
            f = (f * j) % M
        sum = (sum + f) % M
    return sum

int total = 0
if args.mode == "steady"
    for k in range(0, args.iters)
        time.Instant started = time.now()
        total = workload()
        time.Duration elapsed = time.since(started)
        int nanoseconds = math.floor(elapsed.seconds() * 1000000000.0)
        print("ITER {k} {nanoseconds}")
else
    total = workload()
print("MB02 {total}")
