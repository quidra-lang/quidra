print("ADV-START")
io.flush()
string read_input_line()
    string line = ""
    void | error read = scan(&line)
    match read
        void
            return line
        error problem
            process.exit(2)
int scale(int value)
    return value * 3
string text = read_input_line()
int result = scale(text)
print("OBS=R:{result}")
io.flush()
print("ADV-END")
io.flush()
