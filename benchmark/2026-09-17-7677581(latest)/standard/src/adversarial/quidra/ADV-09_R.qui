string | error next_line()
    auto received = try input()
    match received
        string text
            return text
        none
            return error("no line")

void | error run()
    int64[] values = [10, 20, 30, 40, 50]
    int index = try int.parse(try next_line())
    int64 element = values[index]
    print("OBS=ELEM:{element}")
    return void

print("ADV-START")
run()
print("ADV-END")
