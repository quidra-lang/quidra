// MB-07 - Sorting: bottom-up (iterative) merge sort, ascending, stable,
// ping-pong buffers. The pinned algorithm only; no standard-library sort.
// Storage: int[] (runtime-sized array of 64-bit integers).
// Methodology 06 section 5.2 program modes: argv[1] in {once, steady}, argv[2] = K.
cli args
    string mode = argument(default = "once")
    int iterations = argument(default = 7)

// Lehmer / MINSTD generator, frozen for every language in the suite.
class Lcg
    int state

    int next_int()
        state = (48271 * state) % 2147483647
        return state

// One merge pass of the pinned algorithm from src into dst at the given width.
void merge_pass(const int[] &src, int[] &dst, int n, int width)
    int lo = 0
    while lo < n
        int mid = math.min(lo + width, n)
        int hi = math.min(lo + 2 * width, n)
        int i = lo
        int j = mid
        int k = lo
        while i < mid and j < hi
            if src[i] <= src[j]
                dst[k] = src[i]
                i = i + 1
            else
                dst[k] = src[j]
                j = j + 1
            k = k + 1
        while i < mid
            dst[k] = src[i]
            i = i + 1
            k = k + 1
        while j < hi
            dst[k] = src[j]
            j = j + 1
            k = k + 1
        lo = lo + 2 * width

// Sorts a in place, using buf as the scratch half of the ping-pong pair.
void msort(int[] &a, int[] &buf, int n)
    bool from_a = true
    int width = 1
    while width < n
        if from_a
            merge_pass(&a, &buf, n, width)
        else
            merge_pass(&buf, &a, n, width)
        from_a = not from_a
        width = width * 2
    if not from_a
        // An odd number of passes left the sorted data in the scratch buffer.
        for i in range(n)
            a[i] = buf[i]

class Result
    int total
    int ssum
    int inv

// The whole workload body, generation included (methodology 06 section 4, MB-07).
Result workload()
    int n = 2000000
    int rounds = 4
    Lcg g = Lcg(state = 20267917)
    int[] src = array(n, fill = 0)
    for i in range(n)
        src[i] = g.next_int()
    int[] buf = array(n, fill = 0)
    int total = 0
    int ssum = 0
    int inv = 0
    for r in range(rounds)
        src[r] = src[r] + 1
        int[] a = src
        msort(&a, &buf, n)
        int chk = 0
        for i in range(n)
            chk = (chk * 31 + (a[i] % 1000003)) % 1000003
        total = (total * 7 + chk) % 1000003
        ssum = 0
        for i in range(n)
            ssum = ssum + a[i]
        for i in range(1, n)
            if a[i - 1] > a[i]
                inv = inv + 1
    return Result(total = total, ssum = ssum, inv = inv)

Result timed(int index)
    time.Instant start = time.now()
    Result result = workload()
    time.Duration elapsed = time.since(start)
    int elapsed_ns = math.round(elapsed.seconds() * 1000000000.0)
    print("ITER {index} {elapsed_ns}")
    io.flush()
    return result

Result result
if args.mode == "steady"
    int k = math.max(args.iterations, 1)
    result = timed(0)
    for i in range(1, k)
        result = timed(i)
else
    result = workload()

print("MB07 {result.total} {result.ssum} {result.inv}")
