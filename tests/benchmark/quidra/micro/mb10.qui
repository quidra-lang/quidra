// MB-10 - File I/O: write three text files with file.write and read each back
// using the file.read line-stream operator, with integer parsing.
// A stream closes at its owned lifetime boundary; the writer is scoped to
// write_round so it closes before a reader opens the same path.
// Methodology 06 section 5.2 program modes: argv[1] in {once, steady}, argv[2] = K.
cli args
    string mode = argument(default = "once")
    int iterations = argument(default = 7)

// Lehmer / MINSTD generator, frozen for every language in the suite.
class Lcg(local int seed)

    int state
    state = seed

    int .next_int()
        state = (48271 * state) % 2147483647
        return state

class Result()
    int sum_v
    int chk
    int nbytes
    int lines

// The writer must close before the next reader opens this path.
int .write_round(string name, int n, Lcg &generator)
    file.write writer := file.write(name)
    int nbytes := 0
    for: 0 <= int i < n
        int v := .generator.next_int()
        string record := "{i} {v}{NL}"
        .writer(record)
        nbytes += int(len(record))
    return nbytes

// The whole workload body (methodology 06 section 4, MB-10).
Result workload()
    int n := 1000000
    int rounds := 3
    Lcg g := Lcg(20270917)
    int sum_v := 0
    int chk := 0
    int nbytes := 0
    int lines := 0

    for: 0 <= int r < rounds
        string name := "mb10_round_{r}.txt"

        nbytes += .write_round(name, n, &g)
        file.read reader := file.read(name)
        int idx := 0
        while .reader(string &text)
            string[] fields := text.split(" ")
            int a := int.parse(fields[0])
            int v := int.parse(fields[1])
            if a != idx
                process.exit(3)
            idx += 1
            lines += 1
            sum_v = (sum_v + v) % 1000000007
            chk = (chk * 31 + (v % 1000003)) % 1000003

    Result result
    result.sum_v = sum_v
    result.chk = chk
    result.nbytes = nbytes
    result.lines = lines
    return result

Result timed(int index)
    time.Instant start := time.now()
    Result result := workload()
    time.Duration elapsed := time.since(start)
    int elapsed_ns := math.round(elapsed.seconds() * 1000000000.0)
    print("ITER {index} {elapsed_ns}")
    print(NL)
    flush()
    return result

Result result
if args.mode == "steady"
    int k := math.max(args.iterations, 1)
    result = timed(0)
    for: 1 <= int i < k
        result = timed(i)
else
    result = workload()

print("MB10 {result.sum_v} {result.chk} {result.nbytes} {result.lines}")
print(NL)
