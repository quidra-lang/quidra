class Point
    int x = 1
    int y = 2

    construct(int x = 1)
        this.x = x

    int sum()
        return this.x + this.y

class ShiftedPoint
    Point point = Point()
    int offset = 1

    int sum()
        return this.point.sum() + this.offset

Point a
Point b = Point(1)
ShiftedPoint shifted

