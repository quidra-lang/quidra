print("ADV-START")
print(NL)
flush()
string read_input_line()
    string line = ""
    void | error read = scan(&line)
    match read
        void
            return line
        error problem
            process.exit(2)
uint32 a = uint32.parse(read_input_line())
uint32 b = uint32.parse(read_input_line())
uint32 r = a - b
print("OBS=SUB:{r}")
print(NL)
flush()
print("ADV-END")
print(NL)
flush()
