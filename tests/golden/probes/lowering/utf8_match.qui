// match over string.from_utf8(bin(bytes)) of a fully initialized local: the
// text idiom, with cases that end their blocks and a string case without a
// binder.
int code(bool valid)
    nat8[] bytes = [111, 107]
    if not valid
        bytes = [255, 255]
    match string.from_utf8(bin(bytes))
        string
            return 1
        error problem
            return 0

