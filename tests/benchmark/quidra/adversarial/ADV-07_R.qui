print("ADV-START")
print(NL)
flush()
string read_input_line()
    string line = ""
    void | error read = scan(&line)
    match read
        void
            return line
        error problem
            process.exit(2)
real64 a = real64.parse(read_input_line())
real64 b = real64.parse(read_input_line())
real64 h = a / b
real64 mean = (1.0 + h + 3.0) / 3.0
real64 diff = h - h
print("OBS=MEAN:{mean:frac=6}|DIFF:{diff:frac=6}")
print(NL)
flush()
print("ADV-END")
print(NL)
flush()
