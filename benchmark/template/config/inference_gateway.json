{
  "schema_version": 1,
  "protocol": "quidra-inference-gateway-v1",
  "socket_path": "/quidra-benchmark/gateway/inference.sock",
  "socket_directory": "/quidra-benchmark/gateway",
  "socket_mode": 432,
  "transport": "af-unix-stream-newline-delimited-json",
  "client_credentials": "none",
  "allowed_request_kinds": [
    "health.request",
    "inference.request"
  ],
  "forbidden_request_fields": [
    "tools",
    "tool_choice",
    "tool_use",
    "functions",
    "function_call",
    "mcp_servers",
    "connectors",
    "files",
    "file_paths",
    "attachments",
    "shell",
    "command",
    "argv",
    "cwd",
    "env",
    "environment",
    "api_key",
    "auth",
    "authorization",
    "credentials",
    "provider_options",
    "base_url",
    "proxy"
  ],
  "max_request_bytes": 4194304,
  "max_response_bytes": 2097152,
  "max_messages": 256,
  "max_output_tokens_ceiling": 32768,
  "request_timeout_seconds": 900,
  "default_network_policy": "disabled",
  "network_policies": [
    "disabled",
    "allowed"
  ],
  "provider_ids": [
    "fake",
    "exec",
    "anthropic-messages"
  ],
  "sandbox_forbidden_credential_environment_names": [
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_AUTH_TOKEN",
    "ANTHROPIC_BASE_URL",
    "CLAUDE_CODE_MESSAGING_TOKEN",
    "CLAUDE_CODE_OAUTH_TOKEN",
    "CLAUDE_API_KEY",
    "OPENAI_API_KEY",
    "AZURE_OPENAI_API_KEY",
    "GOOGLE_API_KEY",
    "GEMINI_API_KEY",
    "VERTEX_AI_ACCESS_TOKEN",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN",
    "GH_TOKEN",
    "GITHUB_TOKEN",
    "SSH_AUTH_SOCK",
    "SSH_AGENT_PID"
  ],
  "sandbox_forbidden_credential_paths": [
    ".claude",
    ".claude.json",
    ".config/anthropic",
    ".config/claude",
    ".config/gcloud",
    ".config/gh",
    ".aws",
    ".ssh",
    ".netrc",
    ".npmrc",
    ".docker/config.json",
    ".git-credentials"
  ],
  "note": "The gateway is a pure model-inference broker. It accepts only the request kinds listed here, rejects every request field that could describe a tool, file, command, credential or endpoint, and never exposes host filesystem, shell, repository or agent-platform tools to the model. Provider credentials exist only in the trusted gateway process; the scored sandbox reaches the gateway through a credential-less Unix domain socket."
}
