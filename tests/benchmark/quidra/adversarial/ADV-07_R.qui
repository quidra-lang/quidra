print("ADV-START")
io.flush()
string read_input_line()
    string | none | error line = input()
    match line
        string text
            return text
        none
            process.exit(2)
        error problem
            process.exit(2)
float a = float.parse(read_input_line())
float b = float.parse(read_input_line())
float h = a / b
float mean = (1.0 + h + 3.0) / 3.0
float diff = h - h
print("OBS=MEAN:{mean:frac=6}|DIFF:{diff:frac=6}")
io.flush()
print("ADV-END")
io.flush()
