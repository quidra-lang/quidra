// Probe: a deterministic scope-exit cleanup construct that also runs on the
// error path.  Quidra 0.2.0 has no defer, destructor, with-block or
// try-with-resources construct (keyword set: and argument break class cli const
// continue default elif else extern false flag for if import in match none not
// option or override return super true try void while).
int | error f()
    defer print("X09 cleanup ")
    return error("boom")

match f()
    int v
        print("{v}")
    error e
        print("caught")
