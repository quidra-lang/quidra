// Floating arithmetic and formatted interpolation in both formats.
real64 x := 2.5
real64 y := -0.125
real32 p := 1.5
real32 q := 0.25
print("{x + y} {x - y} {x * y} {x / y} {x ^ 2.0}")
print(NL)
print("{p + q} {p - q} {p * q} {p / q} {p ^ real32(3.0)}")
print(NL)
print("{x:.3} {y:2} {x:5.1} {p:04.2}")
print(NL)
print("{x > y} {p <= q} {x == 2.5} {-x}")
print(NL)
real64 total := 0.0
for: 0 <= nat i < 10
    total = total + 0.1
print("{total}")
print(NL)
