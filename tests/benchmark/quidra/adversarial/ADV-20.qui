print("ADV-START")
io.flush()
string read_input_line()
    string line = ""
    void | error read = scan(&line)
    match read
        void
            return line
        error problem
            process.exit(2)
int f(int n)
    if n == 1000000
        return 0
    return 1 + f(n + 1)
int start = int.parse(read_input_line())
int result = f(start)
print("OBS=R:{result}")
io.flush()
print("ADV-END")
io.flush()
