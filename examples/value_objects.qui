class Point(local int x_initial = 1)
    int x = 1
    int y = 2


    x = x_initial

    int sum()
        return x + y

class ShiftedPoint()
    Point point = Point()
    int offset = 1

    int sum()
        return point.sum() + offset

Point a = Point()
a.x = 1
a.y = 2
Point b = Point(1)
ShiftedPoint shifted = ShiftedPoint()

int[] left = [1, 2, 3]
int[] right = [1, 2, 3]

print.line(a == b)
print.line(left == right)
print.line(shifted.sum())
