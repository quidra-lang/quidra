// a comment mentioning if, for, return, int and string
int counter = 0
string interior = "if for return int string else while"
string mixed = "value {counter} with braces {{literal}}"
int returns_here = 3
int for_each = 4
bool okay = true and not false
const int fixed_value = 7
while counter < 2
    counter = counter + 1
    if counter == 1
        continue
    else
        break
string shown = counter.string()
print(interior)
print(mixed)
print(shown)
print("{returns_here} {for_each} {fixed_value}")
if okay
    print("yes")
