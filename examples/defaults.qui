void replace(int[] &values, int count := 3)
    values = array(nat(count), fill = 7)

int[] data := []
replace(&values = &data)
print.line(data[2])

int choose(bool condition, fallback := int(20))
    int answer
    if condition
        answer = 10
    else
        answer = fallback
    return answer

print.line(choose(false))
