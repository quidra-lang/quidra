// CURRENT-EQUIVALENT DIAGNOSTIC: uses uint8[] working bytes and explicit string.from_utf8; the frozen historical source remains unchanged.
// MB-08 strings: build the text, then five explicit character-level passes per round.
// Passes 1-4 operate on `bytes`, Quidra's mutable byte-oriented sequence, as
// section 4.12(b) pins. Pass 5 operates on a native `string` value constructed
// fresh inside each timed round from that working buffer and read with
// `text[i]`, which is the code-point access API section 4.12(b) pins for Quidra.
//
// The frozen v0.1 source reconstructed text through a per-byte glyph array
// because no checked binary-to-text conversion existed. Current Quidra exposes
// explicit `string.from_utf8(bin) -> string | error`, so this diagnostic keeps
// working data byte-oriented and performs one explicit validated conversion for
// the native-string pass.
//
// Mode selection (methodology 06 section 5.2). Quidra's `cli` module has no
// OPTIONAL positional argument: `argument()` is positional but mandatory (a bare
// `./BIN` then exits with CLI status 2, which would break the frozen `once`
// recipe), and `option(default = ...)` is optional but named. The optional form
// is the one that preserves section 5.2's semantics, so the mode is spelled
// `--mode steady --iters K` instead of `argv[1] argv[2]`.
//
// Section 5.2 also requires each ITER line to be flushed immediately, and
// Quidra v0.1 cannot do that: `print` lowers to C `puts` on block-buffered
// stdout (quidra/src/llvm_backend.cpp:2195, :2202, :2209; `declare i32 @puts`
// at :2829) and the standard library exposes no flush call. Measured: this
// program run in steady mode with stdout redirected to a file and SIGKILLed
// after three iterations had completed produced 0 bytes of output. Section
// 5.4's partial-retention rule (rule 1) is therefore inert for this
// configuration; a steady process stopped at the timeout falls to rule 2.

cli args
    string mode = option(default = "once")
    int iters = option(default = 7)

int rolling_hash(const uint8[] &sequence, int size)
    int h = 0
    for i in range(0, size)
        h = (h * 131 + int(sequence[i])) % 1000000007
    return h

class Result
    int accumulator = 0
    int size = 0
    int count_ab = 0
    int count_words = 0

Result workload()
    const int word_count = 200000
    const int rounds = 20
    const int modulus = 1000000007
    int state = 20268917

    string[] alphabet = [
        "a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m",
        "n", "o", "p", "q", "r", "s", "t", "u", "v", "w", "x", "y", "z",
    ]

    string[] words = []
    for w in range(0, word_count)
        state = (state * 48271) % 2147483647
        int length = 4 + state % 13
        string[] characters = []
        for c in range(0, length)
            state = (state * 48271) % 2147483647
            characters = characters.append(alphabet[state % 26])
        words = words.append(characters.join(""))

    string text = words.join(" ")
    uint8[] data = uint8[](text.utf8())
    int size = len(data)

    int accumulator = 0
    int count_ab = 0
    int count_words = 0

    for round in range(0, rounds)
        int p = 7 * round + 11
        if data[p] == 32
            data[p] = 120
        else
            data[p] = 97 + (data[p] - 97 + 1) % 26

        int h1 = rolling_hash(&data, size)

        uint8[] upper = array(size, fill = 0)
        for i in range(0, size)
            uint8 c = data[i]
            if c >= 97 and c <= 122
                upper[i] = c - 32
            else
                upper[i] = c
        int h2 = rolling_hash(&upper, size)

        uint8[] backward = array(size, fill = 0)
        for i in range(0, size)
            backward[i] = data[size - 1 - i]
        int h3 = rolling_hash(&backward, size)

        count_ab = 0
        for i in range(0, size - 1)
            if data[i] == 97 and data[i + 1] == 98
                count_ab += 1

        // pass 5: word count on a freshly constructed native string.
        // The working byte array is explicitly packed to bin, then UTF-8 is
        // explicitly validated; invalid text is an ordinary typed failure.
        string s = ""
        match string.from_utf8(bin(data))
            string decoded
                s = decoded
            error problem
                process.exit(1)
        count_words = 1
        for i in range(0, size)
            if s[i] == " "
                count_words += 1

        int[] fields = [h1, h2, h3, count_ab, count_words]
        for value in fields
            accumulator = (accumulator * 31 + value) % modulus

    return Result(accumulator = accumulator, size = size,
                  count_ab = count_ab, count_words = count_words)

Result out = Result()
if args.mode == "steady"
    for k in range(0, args.iters)
        time.Instant started = time.now()
        out = workload()
        time.Duration elapsed = time.since(started)
        int nanoseconds = math.floor(elapsed.seconds() * 1000000000.0)
        print("ITER {k} {nanoseconds}")
else
    out = workload()
print("MB08 {out.accumulator} {out.size} {out.count_ab} {out.count_words}")
