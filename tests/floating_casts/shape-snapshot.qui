tensor<real32> raw := tensor.ones<real32>([2, 2])
tensor<real32> x := raw.track()
tensor<real16> y := real16(x.transpose(0, 1))
tensor<real16> changed := y.untrack()
changed[0, 0] = real16(9)
raw[0, 0] = real32(7)
print(y.untrack()[0, 0].item() == real16(1))
print(NL)
tensor<real16> loss := y.gather([0, 1, 2, 3], [4]).gather([0], [])
loss.backward(&x)
print(x.grad[0, 0].item() == real32(1) and x.grad[1, 1].item() == real32(0))
print(NL)
