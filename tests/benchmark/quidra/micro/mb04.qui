// MB-04 - Floating-point arithmetic: four accumulators over two arrays.
// Storage: float[] (runtime-sized array of binary64), Quidra's ordinary contiguous array.
// Methodology 06 section 5.2 program modes: argv[1] in {once, steady}, argv[2] = K.
cli args
    string mode = argument(default = "once")
    int iterations = argument(default = 7)

// Lehmer / MINSTD generator, frozen for every language in the suite.
class Lcg
    int state

    construct(int seed)
        state = seed

    int next_int()
        state = (48271 * state) % 2147483647
        return state

    float next_unit()
        return float(next_int()) / 2147483647.0

class Result
    float s1
    float s2
    float s3
    float s4

// The whole workload body, generation included (methodology 06 section 4, MB-04).
Result workload()
    int m = 4000
    int rounds = 75000
    Lcg g = Lcg(20264917)
    float[] a = array(m, fill = 0.0)
    float[] b = array(m, fill = 0.0)
    for i in range(m)
        a[i] = 0.5 + g.next_unit()
    for i in range(m)
        b[i] = 0.5 + g.next_unit()
    float s1 = 0.0
    float s2 = 0.0
    float s3 = 0.0
    float s4 = 0.0
    for r in range(rounds)
        a[r % m] = a[r % m] + 1.0e-9
        for i in range(m)
            float x = a[i]
            float y = b[i]
            s1 = s1 + x * y
            s2 = s2 + x / (y + 2.0)
            s3 = s3 + math.sqrt(x * x + y * y)
            s4 = s4 + (x - y) * (x - y)
    Result result
    result.s1 = s1
    result.s2 = s2
    result.s3 = s3
    result.s4 = s4
    return result

Result timed(int index)
    time.Instant start = time.now()
    Result result = workload()
    time.Duration elapsed = time.since(start)
    int elapsed_ns = math.round(elapsed.seconds() * 1000000000.0)
    print("ITER {index} {elapsed_ns}")
    io.flush()
    return result

Result result
if args.mode == "steady"
    int k = math.max(args.iterations, 1)
    result = timed(0)
    for i in range(1, k)
        result = timed(i)
else
    result = workload()

print("MB04 s1={result.s1:sig=17} s2={result.s2:sig=17} s3={result.s3:sig=17} s4={result.s4:sig=17}")
