tensor<real32> master := (tensor.ones<real32>([]) * real32(1.00390625)).track()
tensor<real16b> low := real16b(master)
print(low.untrack().item() == real16b(1))
print(NL)
tensor<real16b> loss := low * real16b(1.0078125)
loss.backward(&master)
print(master.grad.item() == real32(1.0078125))
print(NL)
loss.backward(&master)
print(master.grad.item() == real32(2.015625))
print(NL)
