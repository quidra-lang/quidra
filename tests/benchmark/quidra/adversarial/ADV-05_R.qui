print("ADV-START")
io.flush()
string read_input_line()
    string line = ""
    void | error read = scan(&line)
    match read
        void
            return line
        error problem
            process.exit(2)
float v = float.parse(read_input_line())
int32 r = int32(math.trunc(v))
print("OBS=V:{r}")
io.flush()
print("ADV-END")
io.flush()
