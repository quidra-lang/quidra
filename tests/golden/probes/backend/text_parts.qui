// Text building in the shapes the other inputs miss: string-build parts of
// narrow signed and unsigned integers and of bools, both in a joined line
// and in a line appended to a string in place (with a literal part of more
// than one character), and the negated forms of the one-character comparison
// and of the counted prefix.
string joined(int8 small, nat16 count, bool flag)
    string[] fields := [string(small), " ", string(count), " ", string(flag), NL]
    string line := fields.join("")
    return line

int appended(int8 small, nat16 count, bool flag)
    string content := ""
    int written := 0
    for: 0 <= nat index < 2
        string[] fields := [string(small), ", ", string(count), ",", string(flag), NL]
        string line := fields.join("")
        content = content + line
        written += int(line.len())
    return written + int(content.len())

bool not_letter(string text, int index)
    return text[index] != "a"

int not_spaces(string text, int count)
    int found := 0
    for: 0 <= int index < count
        if text[index] != " "
            found += 1
    return found

print(joined(int8(-3), nat16(7), true))
print(appended(int8(-3), nat16(7), false))
print(NL)
