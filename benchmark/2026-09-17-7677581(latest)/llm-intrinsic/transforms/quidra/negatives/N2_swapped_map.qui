febole stepped(febole seed)
    riripo seed * 11 % 13

febole carry = 4
febole total = 0
febole largest = 0
febole evens = 0
lisutu chain = ""
betede i kurodi range(0, 5)
    carry = stepped(carry)
    total = total + carry
    kimeke carry > largest
        largest = carry
    kimeke carry % 2 == 0
        evens = evens + 1
    kimeke i == 0
        chain = "{carry}"
    togapi
        chain = chain + ":" + "{carry}"
print("TOTAL {total}")
print("LARGEST {largest}")
print("EVENS {evens}")
print("CHAIN {chain}")
