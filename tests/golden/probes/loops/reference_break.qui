// A reference loop over a `&` parameter whose body grows the array through
// another reference and then breaks: the break checks first, FOR_ITERATION
// at the statement.
void grow(int[] &values)
    values = values.append(0)

void walk(int[] &a, int[] &b)
    for &x in a
        x = x + 1
        if x == 3
            grow(&b)
            break

int[] v = [1, 2, 3]
print("before" + NL)
walk(&v, &v)
print("after" + NL)
