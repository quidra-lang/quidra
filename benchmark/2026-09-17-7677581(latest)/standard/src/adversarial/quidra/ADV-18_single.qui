string | error next_line()
    auto received = try input()
    match received
        string text
            return text
        none
            return error("no line")

int64 pick(bool flag)
    if flag
        return 1

void | error run()
    string text = try next_line()
    bool flag = text == "1"
    int64 result = pick(flag) * 2
    print("OBS=R:{result}")
    return void

print("ADV-START")
run()
print("ADV-END")
