#pragma once
#include <string>
#include <string_view>

// Generated from project.toml at configure time. Edit project.toml, not this
// template's output: these constants are the compiler's only copy of the
// project metadata, so anything that needs one must read it from here.

namespace quidra {

inline constexpr std::string_view language_name = "@QUIDRA_PROJECT_NAME@";
inline constexpr std::string_view cli_name = "@QUIDRA_PROJECT_CLI@";
inline constexpr std::string_view source_extension = "@QUIDRA_PROJECT_EXTENSION@";
inline constexpr std::string_view tagline = "@QUIDRA_TAGLINE@";

inline constexpr std::string_view compiler_version = "@PROJECT_VERSION@";
inline constexpr std::string_view language_version = "@QUIDRA_LANGUAGE_VERSION@";

// Format versions, independent of compiler_version.
inline constexpr std::string_view ir_version = "@QUIDRA_IR_VERSION@";
inline constexpr int abi_version = @QUIDRA_ABI_VERSION@;
inline constexpr int package_schema_version = @QUIDRA_PACKAGE_SCHEMA_VERSION@;
inline constexpr int lockfile_schema_version = @QUIDRA_LOCKFILE_SCHEMA_VERSION@;

// Package-manager layout/naming contract.
inline constexpr std::string_view package_manifest_filename = "@QUIDRA_PACKAGE_MANIFEST_FILE@";
inline constexpr std::string_view package_project_filename = "@QUIDRA_PACKAGE_PROJECT_FILE@";
inline constexpr std::string_view package_lock_filename = "@QUIDRA_PACKAGE_LOCK_FILE@";
inline constexpr std::string_view package_entrypoint_stem = "@QUIDRA_PACKAGE_ENTRYPOINT_STEM@";
inline constexpr std::string_view package_store_relative = "@QUIDRA_PACKAGE_STORE_RELATIVE@";
inline constexpr std::string_view official_distribution_prefix = "@QUIDRA_OFFICIAL_DISTRIBUTION_PREFIX@";
inline constexpr std::string_view official_repository_base = "@QUIDRA_OFFICIAL_REPOSITORY_BASE@";

inline std::string source_filename(std::string_view stem) {
    return std::string(stem) + std::string(source_extension);
}

inline std::string package_entrypoint_filename() {
    return source_filename(package_entrypoint_stem);
}

inline std::string current_lockfile_header() {
    return "quidra-lock-v" + std::to_string(lockfile_schema_version);
}

} // namespace quidra
