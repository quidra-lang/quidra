print("ADV-START")
io.flush()
string read_input_line()
    string | none | error line = input()
    match line
        string text
            return text
        none
            process.exit(2)
        error problem
            process.exit(2)
float a = float.parse(read_input_line())
float b = float.parse(read_input_line())
float m = a / b
float[] xs = [3.0, m, 1.0]
float best = xs[0]
for i in range(1, 3)
    float x = xs[i]
    if x > best
        best = x
bool selfeq = m == m
print("OBS=MAX:{best:frac=6}|SELFEQ:{selfeq}")
io.flush()
print("ADV-END")
io.flush()
