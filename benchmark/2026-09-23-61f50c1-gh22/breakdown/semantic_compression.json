{
  "aggregation": {
    "coverage_from_support": {
      "formula": "100 * sum(capability_points * support_factor) / sum(capability_points)",
      "requires_every_probe": true,
      "why": "Capability Coverage is the sum of the points the frozen award_formula gives each probe's support level, so it is derivable from the levels themselves. Deriving it keeps the published coverage and the levels the comparability audit judged as one statement instead of two: when a support adjudication settles a level across the cohort, coverage follows it. The derivation reproduces every shard's own reported value exactly on the run it was written against, so it invents nothing; it only removes the gap a corrected level would otherwise open."
    },
    "coverage_metric": "metric.capability_coverage",
    "quality_weights": {
      "metric.capability_efficiency": 0.15,
      "metric.hidden_semantic_cost": 0.2,
      "metric.semantic_density": 0.2,
      "metric.semantic_determinacy": 0.25,
      "metric.semantic_locality": 0.2
    },
    "recompute_from_evidence": {
      "common_basis": "probes for which all ten languages recorded a per-probe row",
      "metrics": {
        "metric.capability_efficiency": {
          "denominator_pattern": "supported_capability_points",
          "direction": "lower_is_better",
          "numerator_pattern": "(total_(semantic_)?complexity_units|sum_of_totals)",
          "raw_patterns": [
            "raw.*(_e\\b|_e_|efficiency)",
            "efficiency.*raw",
            "units_per_point"
          ],
          "reduce": "language_ratio"
        },
        "metric.hidden_semantic_cost": {
          "direction": "lower_is_better",
          "fields": [
            "count",
            "hidden_count",
            "hidden",
            "categories_triggered",
            "hidden_categories"
          ],
          "reduce": "mean"
        },
        "metric.semantic_density": {
          "denominator": [
            "tokens",
            "lexical_tokens",
            "token_count",
            "lexical_source_tokens",
            "source_tokens"
          ],
          "direction": "higher_is_better",
          "numerator": [
            "explicit_local_facts",
            "explicit_local_sites",
            "explicit_local_count",
            "explicit_local",
            "explicit_local_semantic_sites"
          ],
          "reduce": "ratio"
        },
        "metric.semantic_determinacy": {
          "direction": "lower_is_better",
          "fields": [
            "b",
            "b_i",
            "branching",
            "branch_count",
            "branching_factor",
            "interpretations"
          ],
          "reduce": "mean_log2"
        },
        "metric.semantic_locality": {
          "direction": "lower_is_better",
          "fields": [
            "l",
            "lookups",
            "lookup_count",
            "required_lookups",
            "hops",
            "nonlocal_lookups",
            "lookup"
          ],
          "reduce": "mean"
        }
      },
      "normalization": "min_max_across_languages",
      "why": "Methodology 6.1.4 freezes each metric's raw value and its direction but not the map from that raw value to the 0-100 scale the metrics are reported on, and a language shard cannot see the other nine. Left to the workers, the first full run received min(100, raw*1000) from one language, min(100, raw/0.35*100) from another and raw*100 from five more, which the harmonic combination would have mixed into a ranking. The runner recomputes every quality metric from the per-probe evidence each shard recorded, on the basis the shards themselves said it must: the probes every language covered."
    },
    "support_level_owner": {
      "fields": [
        "support",
        "support_level",
        "level"
      ],
      "fields_note": "The shards wrote the same statement under different names - a bare `support`, or a `level` inside a `per_probe_support` mapping - so the owner's level is read under any of these names, exactly as sc_row_number reads a metric's raw value under its own synonyms. A shard in a new shape needs this list extended.",
      "levels": {
        "FULL": 1.0,
        "NONE": 0.0,
        "PARTIAL": 0.5
      },
      "requirement_id": "metric.capability_coverage",
      "why": "Every metric shard annotated the support level of every probe it touched, and nothing reconciled them, so one language could carry several levels for one probe under different field names. The first blinded comparability audit correctly refused such a sample: a record that states two levels has not stated one. Capability Coverage is the metric that is definitionally the support ledger, so it owns the level; the others cite it. The runner projects that one level, and the points the frozen award_formula derives from it, into the audit sample, and records every annotation it replaced."
    },
    "type": "semantic_harmonic"
  },
