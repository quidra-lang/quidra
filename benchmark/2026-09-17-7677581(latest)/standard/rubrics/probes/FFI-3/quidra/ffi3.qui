class Record
    int32 count
    float64 weight

extern float64 c_weighted(Record record) = "supplied_weighted"
extern void c_sort_doubles(float64[] &values, uint64 count) = "qsort_doubles"

Record r = Record(count = 3, weight = 1.5)
print(c_weighted(r))

float64[] xs = [3.5, 1.25, 4.75, 1.5, 2.25]
c_sort_doubles(&xs, 5)
for x in xs
    print(x)
