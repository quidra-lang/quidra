int32 caller()
    // BEGIN PROBE F06.P2
    DivMod result = divmod2(7, 2)
    int32 q = result.quotient
    int32 r = result.remainder
    return q + r

class DivMod
    int32 quotient
    int32 remainder

DivMod divmod2(int32 a, int32 b)
    return DivMod(quotient = a / b, remainder = a % b)
    // END PROBE F06.P2

print(caller())
