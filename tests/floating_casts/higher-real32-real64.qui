tensor<real32> x := (tensor.ones<real32>([]) * real32(2)).track()
tensor<real64> y := real64(x)
(y * y).backward(&x, track = true)
tensor<real32> first := x.grad
print(first.is_tracked())
print(NL)
print(first.untrack().item() == real32(4))
print(NL)
.x.clear_grad()
first.backward(&x)
print(x.grad.item() == real32(2))
print(NL)
