string | error next_line()
    auto received = try input()
    match received
        string text
            return text
        none
            return error("no line")

void | error run()
    int64 a = try int64.parse(try next_line())
    int64 b = try int64.parse(try next_line())
    int64 q = a / b
    print("OBS=QUOT:{q}")
    return void

print("ADV-START")
run()
print("ADV-END")
