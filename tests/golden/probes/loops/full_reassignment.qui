// A value loop iterates the value at loop entry while its body replaces
// the iterated array, or the object it is a field of.
class Holder()
    int[] items

int[] values := [1, 2, 3]
for v := values[]
    print("{v} ")
    values = [7, 8]
print("| {values.len()}")
print(NL)
Holder h := Holder()
h.items = [1, 2, 3]
for v := h.items[]
    print("{v} ")
    h.items = [9]
print("| {h.items.len()}")
print(NL)
Holder g := Holder()
g.items = [1, 2, 3]
for v := g.items[]
    print("{v} ")
    Holder fresh := Holder()
    fresh.items = [5, 5, 5, 5]
    g = fresh
print("| {g.items.len()}")
print(NL)
int[][] rows := [[1, 2, 3], [4]]
for v := rows[0][]
    print("{v} ")
    rows[0] = [0]
print("| {rows[0].len()}")
print(NL)
