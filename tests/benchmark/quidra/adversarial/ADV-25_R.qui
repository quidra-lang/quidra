print("ADV-START")
io.flush()
string read_input_line()
    string line = ""
    void | error read = scan(&line)
    match read
        void
            return line
        error problem
            process.exit(2)
string text = read_input_line()
int value = int.parse(text)
int product = value * 2
print("OBS=R:{product}")
io.flush()
print("ADV-END")
io.flush()
