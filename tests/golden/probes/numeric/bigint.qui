// bigint arithmetic beyond 64 bits, division, remainder and comparison, in
// and out of loops.
int big = 1
for i in range(80)
    big = big * 3
print("{big}")
print(NL)
int other = big / 7
print("{other} {big % 7} {big - other * 7}")
print(NL)
int negative = -big
print("{negative} {negative < big} {negative + big == 0}")
print(NL)
int sum = 0
for i in range(1000)
    sum = sum + int(i) * int(i)
print("{sum}")
print(NL)
int factorial = 1
int n = 1
while n <= 30
    factorial = factorial * n
    n = n + 1
print("{factorial}")
print(NL)
