class Point(local int x_initial, local int y_initial)
    int x
    int y


    x = x_initial
    y = y_initial

    int sum()
        return x + y

    int doubled()
        return sum() * 2

class LabeledPoint(local Point point_initial, local string label_initial)
    Point point
    string label


    point = point_initial
    label = label_initial

    int sum()
        return point.sum()

class OffsetPoint(local Point point_initial, local int offset_initial)
    Point point
    int offset


    point = point_initial
    offset = offset_initial

    int sum()
        return point.sum() + offset

class Box(local Point point_initial)
    Point point


    point = point_initial

class Counter(local int value_initial)
    int value


    value = value_initial

    void .increment()
        value = value + 1

a := Point(1, 2)
b := a
b.x = 9

&alias := &a
alias.y = 5

labeled := LabeledPoint(Point(3, 4), "p")
offset := OffsetPoint(Point(3, 4), 10)

box := Box(a)
copy := box
copy.point.x = 99

counter := Counter(1)
.counter.increment()

println(a.x)
println(a.y)
println(b.x)
println(a.doubled())
println(labeled.sum())
println(offset.sum())
println(box.point.x)
println(copy.point.x)
println(counter.value)
