print("ADV-START")
io.flush()
string read_input_line()
    string | none | error line = input()
    match line
        string text
            return text
        none
            process.exit(2)
        error problem
            process.exit(2)
float v = float.parse(read_input_line())
int32 r = int32(math.trunc(v))
print("OBS=V:{r}")
io.flush()
print("ADV-END")
io.flush()
