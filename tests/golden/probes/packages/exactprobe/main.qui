// The probe providers of exact-real atoms and operations, so that Core's
// golden probes never depend on Math (native/exactprobe.cpp): σ is the square
// root of two, π is pi, ω lies between 1 and 2 and its enclosure never
// narrows; flip negates and first returns its first argument. The *_v1
// declarations reach the same square root and negation through the
// version-1 provider interface.
const literal real root2 := real.atom("exactprobe", 1)
const literal real pi := real.atom("exactprobe", 2)
const literal real omega := real.atom("exactprobe", 3)
const literal real root2_v1 := real.atom("exactprobe_v1", 1)

real flip(real value)
    return real.unary("exactprobe", 101, value)

real first(real a, real b)
    return real.op("exactprobe", 102, a, b)

real flip_v1(real value)
    return real.unary("exactprobe_v1", 1, value)
