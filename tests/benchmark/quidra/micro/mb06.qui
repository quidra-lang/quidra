// MB-06 - Matrix multiplication: classical i-j-k order over flat row-major storage.
// Methodology 06 section 5.2 program modes: argv[1] in {once, steady}, argv[2] = K.
cli args
    string mode = argument(default = "once")
    int iterations = argument(default = 7)

// Lehmer / MINSTD generator, frozen for every language in the suite.
class Lcg(local int seed)

    int state
    state = seed

    int .next_int()
        state = (48271 * state) % 2147483647
        return state

    real64 .next_unit()
        real64 value := real64(.next_int())
        return value / 2147483647.0

class Result()
    real64 sum_c
    real64 c_first
    real64 c_last

// The whole workload body, generation included (methodology 06 section 4, MB-06).
Result workload()
    int n := 512
    int rounds := 3
    Lcg g := Lcg(20266917)
    real64[] a := array(nat(n * n), fill = 0.0)
    real64[] b := array(nat(n * n), fill = 0.0)
    real64[] c := array(nat(n * n), fill = 0.0)
    for: 0 <= int i < n * n
        a[i] = .g.next_unit()
    for: 0 <= int i < n * n
        b[i] = .g.next_unit()
    for: 0 <= int r < rounds
        a[r] = a[r] + 1.0e-9
        for: 0 <= int i < n
            for: 0 <= int j < n
                real64 s := 0.0
                for: 0 <= int k < n
                    s = s + a[i * n + k] * b[k * n + j]
                c[i * n + j] = s
    real64 sum_c := 0.0
    for: 0 <= int i < n * n
        sum_c = sum_c + c[i]
    Result result
    result.sum_c = sum_c
    result.c_first = c[0]
    result.c_last = c[n * n - 1]
    return result

Result timed(int index)
    time.Instant start := time.now()
    Result result := workload()
    time.Duration elapsed := time.since(start)
    int elapsed_ns := math.round(elapsed.seconds() * 1000000000.0)
    print("ITER {index} {elapsed_ns}")
    print(NL)
    flush()
    return result

Result result
if args.mode == "steady"
    int k := math.max(args.iterations, 1)
    result = timed(0)
    for: 1 <= int i < k
        result = timed(i)
else
    result = workload()

print("MB06 sumC={result.sum_c:17} c_first={result.c_first:17} c_last={result.c_last:17}")
print(NL)
