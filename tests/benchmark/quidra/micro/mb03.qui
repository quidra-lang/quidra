// MB-03 - Integer arithmetic: mixed add / xor / multiply-modulo / divide.
// Methodology 06 section 5.2 program modes: argv[1] in {once, steady}, argv[2] = K.
cli args
    string mode = argument(default = "once")
    int iterations = argument(default = 7)

class Result
    int s_add
    int s_xor
    int s_mul
    int s_div

// The whole workload body (methodology 06 section 4, MB-03).
Result workload()
    int n = 120000000
    int x = 20263917
    int s_add = 0
    int s_xor = 0
    int s_mul = 1
    int s_div = 0
    for i in range(n)
        x = (48271 * x) % 2147483647
        s_add = (s_add + x) % 2147483647
        s_xor = s_xor XOR x
        s_mul = (s_mul * 33 + (x % 97)) % 1000003
        s_div = s_div + x / 1000
    return Result(s_add = s_add, s_xor = s_xor, s_mul = s_mul, s_div = s_div)

Result timed(int index)
    time.Instant start = time.now()
    Result result = workload()
    time.Duration elapsed = time.since(start)
    int elapsed_ns = math.round(elapsed.seconds() * 1000000000.0)
    print("ITER {index} {elapsed_ns}")
    io.flush()
    return result

Result result
if args.mode == "steady"
    int k = math.max(args.iterations, 1)
    result = timed(0)
    for i in range(1, k)
        result = timed(i)
else
    result = workload()

print("MB03 {result.s_add} {result.s_xor} {result.s_mul} {result.s_div}")
