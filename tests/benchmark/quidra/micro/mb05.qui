// MB-05 - Vector inner product: straight-line dot product, repeated R times.
// Storage: float[] (runtime-sized array of binary64), Quidra's ordinary contiguous array.
// Methodology 06 section 5.2 program modes: argv[1] in {once, steady}, argv[2] = K.
cli args
    string mode = argument(default = "once")
    int iterations = argument(default = 7)

// Lehmer / MINSTD generator, frozen for every language in the suite.
class Lcg
    int state

    construct(int seed)
        this.state = seed

    int next_int()
        this.state = (48271 * this.state) % 2147483647
        return this.state

    real64 next_unit()
        real64 value = real64(next_int())
        return value / 2147483647.0

// The whole workload body, generation included (methodology 06 section 4, MB-05).
real64 workload()
    int n = 2000000
    int rounds = 400
    Lcg g = Lcg(20265917)
    real64[] x = array(nat(n), fill = 0.0)
    real64[] y = array(nat(n), fill = 0.0)
    for i in range(n)
        x[i] = 0.5 + g.next_unit()
    for i in range(n)
        y[i] = 0.5 + g.next_unit()
    real64 total = 0.0
    for r in range(rounds)
        x[r] = x[r] + 1.0e-9
        real64 d = 0.0
        for i in range(n)
            d = d + x[i] * y[i]
        total = total + d
    return total

real64 timed(int index)
    time.Instant start = time.now()
    real64 result = workload()
    time.Duration elapsed = time.since(start)
    int elapsed_ns = math.round(elapsed.seconds() * 1000000000.0)
    print("ITER {index} {elapsed_ns}")
    print(NL)
    flush()
    return result

real64 total
if args.mode == "steady"
    int k = math.max(args.iterations, 1)
    total = timed(0)
    for i in range(1, k)
        total = timed(i)
else
    total = workload()

print("MB05 total={total:sig=17}")
print(NL)
