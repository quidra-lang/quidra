class Point
    int x
    int y

    int sum()
        return x + y

    int doubled()
        return sum() * 2

class LabeledPoint : Point
    string label

class OffsetPoint : Point
    int offset

    override int sum()
        return x + y + offset

class Box
    Point point

class Counter
    int value

    void increment()
        value = value + 1

Point a = Point(x = 1, y = 2)
Point b = a
b.x = 9

Point &alias = &a
alias.y = 5

LabeledPoint labeled = LabeledPoint(x = 3, y = 4, label = "p")
OffsetPoint offset = OffsetPoint(x = 3, y = 4, offset = 10)

Box box = Box(point = a)
Box copy = box
copy.point.x = 99

Counter counter = Counter(value = 1)
counter.increment()

print(a.x)
print(a.y)
print(b.x)
print(a.doubled())
print(labeled.sum())
print(offset.sum())
print(box.point.x)
print(copy.point.x)
print(counter.value)
