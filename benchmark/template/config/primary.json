{
  "schema_version": 1,
  "workspace_root": "/quidra-benchmark",
  "primary_first": true,
  "extended_only_after_primary": true,
  "timing": {
    "warmups_per_cell": 2,
    "measured_runs_per_cell": 5,
    "aggregation": "median",
    "outlier_policy": "do_not_drop_valid_samples",
    "cache_policy": "must_be_declared_per_workload"
  },
  "llm_learnability": {
    "keyword_anonymization_seeds": 3,
    "vocabulary_anonymization_seeds": 3,
    "structural_surface_transformation_sets": 2,
    "novel_rule_generalization_trials_per_language": 1,
    "held_out_rule_composition_trials_per_language": 1,
    "prior_conflict_resistance_trials_per_language": 1,
    "extended_keyword_anonymization_seeds": 5,
    "extended_vocabulary_anonymization_seeds": 5,
    "extended_structural_surface_transformation_sets": 3,
    "aggregation": "mean_over_predeclared_replications",
    "note": "The primary counts are frozen before a run and apply identically to all languages. Extended replication is diagnostic and starts only after all primary evaluations are complete or blocked.",
    "max_repair_turns": 3
  },
  "llm_proficiency": {
    "independent_trials_per_replicated_cell": 3,
    "max_repair_turns": 3,
    "extended_independent_trials_per_replicated_cell": 5,
    "fresh_session_per_independent_trial": true,
    "cross_trial_history_sharing": false,
    "primary_workloads": [
      "SVM",
      "GMM",
      "LightGrad"
    ],
    "primary_scenarios": [
      "specification_to_implementation",
      "reference_to_porting"
    ]
  },
  "semantic_compression": {
    "fixed_probe_count": 44,
    "assignment_preference": "one worker handles a probe/group across all 10 languages",
    "score_requires_comparability_gate": true
  },
  "language_quality": {
    "allow_reusable_comparison_language_programs": true,
    "comparison_languages_reusable_by_default": [
      "Python",
      "C++",
      "Rust",
      "Go",
      "Java",
      "TypeScript",
      "Kotlin",
      "Swift",
      "Zig"
    ],
    "quidra_requires_target_commit_reaudit": true,
    "reuse_never_includes_measurements": true,
    "quidra_program_source_policy": "fresh_per_evaluated_commit",
    "quidra_micro_authoring_reads_reusable_comparison_programs": false,
    "mechanical_micro_metrics": [
      "metric.native_execution_performance",
      "metric.long_running_performance",
      "metric.compile_build_performance",
      "metric.memory_efficiency",
      "metric.binary_artifact_size",
      "metric.startup_latency",
      "metric.source_code_size",
      "metric.runtime_overhead"
    ]
  },
  "safety": {
    "preserve_frozen_case_universe": true,
    "do_not_drop_cases_to_save_budget": true
  },
  "scoreability": {
    "complete_requires_integrity_and_comparability_gates": true,
    "unfinished_applicable_work_is_not_na": true,
    "scoreable_but_unaggregated_is_an_error": true
  },
  "privacy": {
    "sandbox_visible_root_only": true,
    "allowed_absolute_path_prefix": "/quidra-benchmark/",
    "forbid_personal_email_in_retained_artifacts": true,
    "forbid_host_home_paths_in_retained_artifacts": true,
    "environment_allowlist_required": true
  },
  "runner": {
    "deterministic_planning": true,
    "planning_llm": false,
    "lease_seconds": 1800,
    "max_attempts_per_work_unit": 3,
    "stale_running_policy": "reclaim_to_pending_then_block_after_max_attempts",
    "aggregation": "runner_only",
    "ranking": "runner_only",
    "max_requirement_ids_per_multi_language_agent": 2,
    "missing_toolchain_policy": "record_infrastructure_blockers_and_continue_other_primary_evaluations",
    "max_quidra_workloads_per_authoring_leaf": 3
  },
  "worker_isolation": {
    "default_mode": "packet-only",
    "allowed_modes": [
      "packet-only",
      "sandbox-agent"
    ],
    "host_tool_capable_leaf_policy": "forbidden",
    "packet_only_local_tools": "disabled",
    "packet_only_input_transport": "self-contained-task-packet",
    "packet_only_output_transport": "structured-worker-response-v1-via-task-apply",
    "packet_only_max_embedded_files": 256,
    "packet_only_max_embedded_bytes": 1048576,
    "packet_only_max_response_files": 64,
    "packet_only_max_response_bytes": 2097152,
    "sandbox_agent_runtime": "process-must-run-inside-attested-sandbox",
    "sandbox_agent_host_credentials": "forbidden",
    "network_policy": "provider-or-sandbox-network-only-never-host-filesystem"
  }
}
