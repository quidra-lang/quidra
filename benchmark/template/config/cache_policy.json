{
  "schema_version": 1,
  "cache_schema_version": 1,
  "target_language": "Quidra",
  "policy": "Only validated measurement results whose complete benchmark input fingerprint matches may be reused. Quidra-containing units are never cacheable. Cache material is trusted runner input and is never exposed as a worker read path.",
  "fingerprint_includes": [
    "evaluation",
    "requirement_ids",
    "assigned_languages",
    "exact_task_packet_sha256",
    "provider",
    "model",
    "frozen_sampling",
    "toolchain_fingerprints_for_assigned_languages",
    "unit_input_hashes",
    "validator_contract",
    "worker_mode",
    "network_policy",
    "runtime_toolchain_manifest_sha256",
    "cache_epoch"
  ],
  "epochs": {
    "semantic_compression": "stable",
    "llm_learnability": "stable",
    "language_quality": "stable",
    "llm_proficiency": "stable",
    "ecosystem": "utc-month"
  },
  "promotion": {
    "require_complete_unit": true,
    "require_current_validator_pass": true,
    "require_complete_primary_evaluation": true,
    "preserve_raw_evidence_in_git": false,
    "raw_evidence_artifact_retention_days": 30
  },
  "prompt_store": {
    "format": "content-addressed-components",
    "canonical_root": "benchmark/template/prompts",
    "promote_after_finalization": true
  }
}
