// A value loop over a field iterates the value at loop entry while the
// body calls a method that grows the field, through the implicit receiver
// inside a method and through an explicit receiver outside.
class Bag this()
    int[] items

    void .grow_items()
        this.items = this.items.append(int(len(this.items)))

    int .walk()
        int total := 0
        for v := this.items[]
            total = total + v
            .grow_items()
        return total

Bag g := Bag()
g.items = [1, 2, 3]
print("method: {.g.walk()} {len(g.items)}")
print(NL)
Bag h := Bag()
h.items = [1, 2, 3]
int total := 0
for v := h.items[]
    total = total + v
    .h.grow_items()
print("receiver call: {total} {len(h.items)}")
print(NL)
