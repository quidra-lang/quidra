int value := 255
int negative := -255
large := nat.parse("18446744073709551616")
println("bin={value.string(base = 2)}")
println("oct={value.string(base = 8)}")
println("hex={value.string(base = 16, uppercase = true)}")
println("signed={negative.string(base = 16, uppercase = true)}")
println("large={large.string(base = 16, uppercase = true)}")
println("interp-bin={value:base=2}")
println("interp-hex={value:base=16,upper}")
println("interp-large={large:base=16,upper}")
