(* Quidra grammar. The release version is owned by project.toml.
   INDENT/DEDENT use four spaces per level.
   Bracketed newlines are insignificant. String backslashes are literal;
   physical CRLF inside a string literal is normalized to LF, so checkout
   line-ending style does not change string data. Control characters use
   NL, HT, CR, DQ, BS, FF, VT, and BL.
   Postfix ! and the Math-backed infix @ are implemented on develop. *)

program          = { NEWLINE | import_decl | export_decl | cli_decl | top_declaration | main_guard | statement }, EOF ;
top_declaration  = [ "private" ], ( extern_decl | enum_decl | class_decl | function_decl | const_binding ) ;
(* `private` is the module-local prefix of top-level declarations and the class-local prefix of
   members. A private top-level declaration is usable only inside its module (source file) and is
   never exported, also not by `public import`. export_decl stays a separate program item:
   `private export "C"` is an error, because exported C functions are public. *)
const_binding    = "const", ( "literal", type | [ type ] ), identifier, ":=", expression, statement_end ;

import_decl      = [ "public" ], "import", identifier,
                   [ "=", ( string | identifier ) ], statement_end ;

extern_decl      = "extern", type, [ "." ], identifier, "(", [ parameters ], ")",
                   "=", string, statement_end ;

export_decl      = "export", string, function_decl ;

cli_decl         = "cli", identifier, NEWLINE, INDENT,
                   cli_field, { cli_field | NEWLINE }, DEDENT ;
cli_field        = type, identifier, "=", cli_source, statement_end ;
cli_source       = "argument", "(", [ "default", "=", expression ], ")"
                 | "option", "(", "default", "=", expression, ")"
                 | "flag", "(", ")" ;

enum_decl        = "enum", identifier, NEWLINE, INDENT,
                   enum_variant, { enum_variant | NEWLINE }, DEDENT ;
enum_variant     = identifier, [ "(", type, ")" ], statement_end ;

class_decl       = class_prototype | class_definition ;
qualified_identifier = identifier, { ".", identifier } ;
class_signature  = "class", qualified_identifier, [ type_parameters ],
                   [ identifier ], "(", [ parameters ], ")", [ "|", "error" ] ;
class_prototype  = class_signature, ";", statement_end ;
class_definition = class_signature, NEWLINE, INDENT,
                   class_item, { class_item | NEWLINE }, DEDENT ;
class_item       = [ "private" ], ( field | method_definition ) | statement ;
method_definition = type, [ "." ], method_name, [ type_parameters ],
                    "(", [ parameters ], ")", suite ;
method_name      = identifier | "operator", "(", ")" | "operator", "[", "]" ;
(* Complete operator names are class methods only. operator[] requires at least
   one parameter. A bare operator method name has no callable special meaning. *)
field            = [ "const" ], type, identifier, [ ":=", expression ], statement_end
                 | [ "const" ], identifier, ":=", expression, statement_end
                 | type, "&", identifier, statement_end
                 | [ type ], "&", identifier, ":=", "&", expression, statement_end ;
(* Ordinary header parameters and direct declarations are members. Header/body
   local declarations are initialization-only. Inner control-block declarations
   are local. Header members initialize first, then executable direct items run
   in source order. Methods do not execute at generation. The optional identifier
   is the fixed instance name. `construct` and `this` are ordinary identifiers. *)

function_decl    = function_prototype | function_definition ;
function_prototype = function_signature, ";", statement_end ;
function_definition = function_signature, suite ;
function_signature = type, [ "." ], identifier, [ type_parameters ],
                   "(", [ parameters ], ")" ;
type_parameters  = "<", type_parameter, { ",", type_parameter }, ">" ;
type_parameter   = identifier, [ ":", generic_constraint ] ;
generic_constraint = "numeric" | "integer" | "floating" | "ordered" | "equatable" ;
parameters       = [ "extend" ], parameter, { ",", parameter }, [ "," ] ;
parameter        = [ "local" ], (
                     ( "const", type | type, [ "&" ] ), identifier, [ ":=", expression ]
                   | [ "const" ], identifier, ":=", expression
                   | [ "const" ], range_constraint, [ ":=", expression ] ) ;
(* `extend` is a contextual modifier permitted only on the first parameter of
   a top-level function. It declares that parameter as the method receiver;
   class methods, constructors, and extern signatures cannot use it. *)

type             = array_type, { "|", array_type } ;
array_type       = type_atom, { "[", [ expression ], "]" } ;
type_atom        = tuple_type | "(", type, ")" | function_type | tensor_type | qualified_identifier, [ type_arguments ] ;
function_type    = "func", "<", type, "(", [ type, { ",", type } ], ")", ">" ;
tensor_type      = "tensor", "<", type, ">", [ brace_shape ] ;
brace_shape      = "{", brace_axis, { ",", brace_axis }, "}" ;
brace_axis       = "..." | "nat", identifier
                 | [ "nat" ], identifier, ":=", expression
                 | range_constraint
                 | "_"
                 | expression ;
integer_expression = integer_term, { ( "+" | "-" ), integer_term } ;
integer_term     = integer_factor, { ( "*" | "/" | "%" ), integer_factor } ;
integer_factor   = ( "+" | "-" ), integer_factor
                 | integer_literal | identifier | "(", integer_expression, ")" ;
type_arguments   = "<", type, { ",", type }, ">" ;

suite            = NEWLINE, INDENT, statement, { statement | NEWLINE }, DEDENT ;
main_guard       = "if", "main", suite ;
statement        = binding | constrained_binding | destructuring | assignment | guarded_assignment | address_assignment | return_stmt |
                   loop_control_stmt | if_stmt | while_stmt | for_stmt | match_stmt | parallel_stmt | expr_stmt ;
binding          = [ "local" ], ( "const", ( "literal", type | [ type ] ), identifier, ":=", expression
                   | type, [ "&" ], identifier
                   | [ type ], identifier, ":=", expression
                   | [ type ], "&", identifier, ":=", "&", expression ), statement_end ;
(* file.read, file.write and file.append are qualified nominal types in type position
   and factory calls in expression position. Bare file is a namespace, not a type. *)
(* `literal` is a contextual keyword, only between `const` and the type:
   `const literal real NAME := EXPRESSION` declares a contextual constant,
   whose type is `real` (or `com`) and whose initializer is a constant exact
   expression; elsewhere `literal` is an ordinary identifier. *)
assignment       = assignable, assignment_operator, expression, statement_end ;
assignment_operator = "=" | "+=" | "-=" | "*=" | "/=" | "%=" ;
constrained_binding = [ "local" ], [ "const" ], range_constraint,
                      ":=", [ "&" ], expression, statement_end ;
guarded_assignment = range_constraint, "=", expression, statement_end ;
range_constraint = bit_or_expr, ascending_op, range_subject, ascending_op, bit_or_expr
                 | bit_or_expr, descending_op, range_subject, descending_op, bit_or_expr
                 | range_subject, relational_op, bit_or_expr
                 | bit_or_expr, relational_op, range_subject ;
range_subject    = [ type, [ "&" ] ], identifier ;
relational_op    = ascending_op | descending_op ;
(* A constraint identifies one ordered numeric scalar and at most two bounds.
   Two bounds select the middle name. With one bound, an explicitly typed name
   is the subject; otherwise x < y selects x, and 0 < x selects x. A guarded
   assignment uses an existing untyped, non-reference subject and no declaration
   modifiers. A required range parameter needs a type; a default may infer it.
   In a brace axis only nat N declares a new captured subject; an untyped subject
   is existing storage and retains axis equality. := on a derived shape axis is
   an exact extent, never a default. Ordinary expression comparisons remain bool. *)
address_assignment = "&", reference_place, "=", "&", expression, statement_end ;
reference_place  = identifier ;
assignable       = postfix ;
return_stmt      = "return", [ expression ], statement_end ;
loop_control_stmt = ( "break" | "continue" ), statement_end ;
if_stmt          = "if", or_expr, suite,
                   { "elif", or_expr, suite }, [ "else", suite ] ;
parallel_stmt    = "parallel", ( suite | for_stmt ) ;
(* parallel for schedules each value iteration as its own independent node. *)
(* Each direct statement is one node. Bindings are visible to later nodes only
   within the block. return, break and continue may not leave a node. *)
while_stmt       = "while", or_expr, suite ;
for_stmt         = "for", [ ":" ], ( range_header | collection_header | zip_header ), suite ;
range_header     = bit_or_expr, ascending_op, [ type ], identifier, ascending_op, bit_or_expr, [ "step", bit_or_expr ]
                 | bit_or_expr, descending_op, [ type ], identifier, descending_op, bit_or_expr, [ "step", bit_or_expr ]
                 | [ type ], identifier, ascending_op, bit_or_expr, [ "step", bit_or_expr ]
                 | bit_or_expr, descending_op, [ type ], identifier, [ "step", bit_or_expr ] ;
ascending_op     = "<" | "<=" ;
descending_op    = ">" | ">=" ;
(* A postfix call may be reflect.each or a traversal function. Such a traversal
   is only an element source or the return of a reflect.Each<T> function. *)
collection_header = ( [ type ], identifier, ":=", postfix
                   | [ type ], "&", identifier, ":=", "&", postfix
                   | identifier, "=", postfix
                   | new_pattern, ":=", [ "&" ], postfix
                   | place_pattern, "=", postfix ), collection_index ;
collection_index = "[", [ [ "nat" ], identifier ], "]" ;
zip_header       = array_value_binding, ",", array_value_binding, { ",", array_value_binding } ;
array_value_binding = ( [ type ], identifier, ":=" | identifier, "=" ), postfix, collection_index ;
(* Zip headers take Array values only, without reference, range, traversal,
   or pattern bindings. Each source may name an index. Sources are evaluated once, left to right;
   each value is snapshotted immediately. Equal lengths are checked before
   the body runs, including when one source is empty. *)
(* Reference collection headers require declarations and & on both sides.
   `for:` declares the range variable or every written collection index;
   plain `for` reuses them. Element := and = remain independent. A type
   annotation on a range declaration requires `for:`. A colon without a
   range variable or index declaration is invalid. Parallel headers follow
   the same rule, but parallel index bindings remain unsupported.
   Range shorthand omits only the inclusive zero bound; full headers win
   when a middle variable and two operators are present. *)
match_stmt       = "match", or_expr, NEWLINE, INDENT,
                   match_case, { match_case | NEWLINE }, DEDENT ;
match_case       = ( type, [ identifier | "(", identifier, ")" ] | match_pattern ), suite ;
match_pattern    = "(", match_element, ",", match_element, { ",", match_element }, ")" ;
match_element    = [ "const" ], type, identifier | type | "_" | match_pattern ;
(* A parenthesized case is a type when it scans as one and its group is followed
   by a name, an array suffix, | or end of line; otherwise it is a pattern. *)
expr_stmt        = expression, statement_end ;

expression       = if_expr | or_expr ;
if_expr          = "if", or_expr, "then", or_expr,
                   { "elif", or_expr, "then", or_expr }, "else", or_expr ;
or_expr          = and_expr, { "or", and_expr } ;
and_expr         = equality, { "and", equality } ;
equality         = comparison, { ( "==" | "!=" ), comparison } ;
comparison       = bit_or_expr, { ( "<" | "<=" | ">" | ">=" ), bit_or_expr } ;
(* Chained comparisons: two or more relational operators at one comparison level form a chain
   `a < b <= c`, meaning `a < b and b <= c` with every operand evaluated at most once, left to
   right, short-circuiting. A chain uses only {<, <=} or only {>, >=}. Two or more `==` at one
   equality level form an equality chain; `!=` never chains and cannot share a level with `==`.
   An unparenthesized relational comparison next to `==` or `!=` (`a < b == c`, `a == b < c`)
   is a mixed chain and a compile error; write `(a < b) == c` for the comparison of a result.
   Arrays and tensors cannot appear in a comparison chain. *)
bit_or_expr      = bit_xor_expr, { "OR", bit_xor_expr } ;
bit_xor_expr     = bit_and_expr, { "XOR", bit_and_expr } ;
bit_and_expr     = shift_expr, { "AND", shift_expr } ;
shift_expr       = term, { ( "<<" | ">>" ), term } ;
term             = factor, { ( "+" | "-" ), factor } ;
factor           = unary, { ( "*" | "/" | "%" | "@" ), unary } ;
unary            = ( "try" | "not" | "NOT" | "-" | "&" ), unary | power ;
power            = ( bounded_range | factorial ), [ "^", unary ] ;
factorial        = ( marked_call | postfix ), [ "!" ] ;
(* ! applies to an integer scalar. Parenthesize a factorial before applying
   another postfix suffix. The lexer recognizes != as one token. @ resolves to
   the first-party Math matmul and shares the multiplicative precedence. *)
bounded_range    = [ range_operand, [ "<" | ">" ] ], ":", [ "<" | ">" ],
                   range_operand, [ ":", range_operand ] ;
range_operand    = { "-" }, factorial ;
(* A standalone range materializes an integer array. Its end is mandatory;
   the omitted start is zero. Range markers touch the first colon. The leading
   sign belongs to the bound in -3:0; parentheses in -(3:0) negate the array.
   A signed endpoint/step ends before power, so :9 ^ 2 and 3:0:-1 ^ 2 square
   the resulting array. Parenthesize compound bounds or steps, e.g. 0:(n + 1).
   Scalar -2 ^ 2 retains the ordinary unary-minus/power precedence. Inside an
   index suffix the colon instead introduces the direct slice grammar below. *)
marked_call      = ".", postfix ;   (* ends in a call or class operator[] access *)
(* Mutation markers (L1): `.` before a definition's name (`void .update()`,
   `extern void .set(...)`) declares that the function may change existing state that its `&`
   parameters do not expose, and one `.` before a call's postfix chain (`.update()`,
   `.obj.update()`, `.mod.T(...)`) marks a call that may. A `.` written before a postfix chain
   covers the calls of that chain (receiver positions), not calls nested in its arguments. A `.`
   where an operand starts is always a marker; a member access follows a complete operand. In a
   type, the `.` of a qualified name touches the name before it, so `T .name(` declares a marked
   function. *)
postfix          = { "#" }, primary,
                   { generic_call | direct_call | index_suffix | member_suffix } ;
(* #value resolves exactly as value.len(), including custom/generic classes,
   visible extensions, default arguments, return types, errors and access/effect
   checks. Its receiver includes postfix selectors, but excludes an unparenthesized
   range: #rows[0] counts a row, #rows ^ 2 squares its length, 0:<#rows and
   #rows>:0 use lengths as bounds, and #(0:3) counts the generated range.
   A recursive # prefix is limited by the normal parser nesting limit. *)
generic_call     = type_arguments, "(", [ arguments ], ")" ;
direct_call      = "(", [ arguments ], ")" ;
(* Type calls reuse direct_call. A single string argument to a numeric
   type or bin parses text and returns T | error. string(value) returns
   the standard text of its single operand. These are semantic rules. *)
index_suffix     = "[", index_item, { ",", index_item }, "]" ;
index_item       = expression
                 | [ slice_start ], ":", [ slice_end ], [ ":", [ expression ] ] ;
(* A negative array element index counts from the end. Slice bounds have
   their own rules and are not translated relative to the length. *)
slice_start      = expression, [ "<" | ">" ] ;   (* a marker touches the colon *)
slice_end        = [ "<" | ">" ], expression ;   (* a marker touches the colon *)
member_suffix    = ".", identifier, [ type_arguments ],
                   [ "(", [ arguments ], ")" ] ;
(* The zero-argument method .len() is defined on arrays, strings and bin;
   #value is its general shorthand, including user-defined len methods.
   len is an ordinary identifier, not a bare built-in function. *)
(* Integer radix string members b2..b36 and B2..B36 use ordinary identifiers
   and member access, without a call: 255.b16 and (-255).B16. Their integer
   receiver and canonical base restrictions are semantic checks, not keywords.
   Postfix access precedes unary minus: -255.b16 would negate a string. *)
primary          = integer_literal | real_literal | imaginary_literal | string |
                   "true" | "false" | "void" | "none" | "inf" |
                   tuple_expr | array | array_generation | identifier | "(", expression, ")" ;
array            = "[", [ expression, { ",", expression }, [ "," ] ], "]" ;
array_generation = "[", "for", [ type ], identifier, ":=", postfix, "[", "]",
                   [ "if", or_expr ], "then", expression, "]" ;
arguments        = argument, { ",", argument }, [ "," ] ;
argument         = "&", identifier, "=", "&", expression
                 | identifier, "=", expression
                 | [ "&" ], expression ;
statement_end    = NEWLINE | EOF ;

(* Output interpolation inside a string uses {expression[:format]}.
   Brackets/braces/parentheses and nested strings in expression are balanced
   before the first top-level colon introduces format. Literal braces use
   {{ and }}. Input targets {&name} and {T &name} take no output format. *)
interpolation_format = decimal_format | radix_format ;
decimal_format   = decimal_precision, [ ":", decimal_count ]
                 | ":", decimal_count ;
decimal_precision = decimal_count
                  | [ decimal_count ], ".", [ decimal_count ] ;
decimal_count    = digit, { digit } ;
radix_format     = "base", "=", decimal_count, [ ",", "upper" ]
                 | "upper", ",", "base", "=", decimal_count ;
(* Decimal counts are bounded: width/significant/group 1..1000,
   fraction 0..1000. A dot without either count is invalid. Without a dot
   the count is significant precision and cannot start with zero. With a
   dot the left count is minimum integer width, prefixed by 0 for zero
   padding; the right count fixes fractional digits. An absent right count
   leaves the fraction unchanged. Leading fractional zeros are accepted.
   A final :G groups integer digits after rounding/padding. Named decimal
   options are not aliases. Radix formats remain integer-only, base 2..36. *)

(* Numeric lexical constraints:
   - integer literals are decimal digits only; 0x/0b/0o prefixes do not exist;
   - decimal real literals contain a decimal point; exponent notation only after it (1.0e8);
     `inf` is the real-family positive-infinity literal, with `-inf` using unary minus;
   - an imaginary literal is a decimal real literal immediately followed by `i` that is not
     followed by an identifier character (2.0i, 1.0e-3i); `i` is not reserved, so
     `int i := 5` stays valid; `2i` is lexed as an integer-form imaginary literal
     and rejected by the checker;
   - literals carry categories, not types: non-negative integer, negative integer
     (unary `-` applied to an integer literal), real, imaginary, and complex (a real
     and an imaginary literal joined by + or -); direct materialization stays
     in that category. Without a resolved context defaults are int, real, com;
     nat requires context and ambiguous numeric union contexts remain errors;
     a numeric value destination may instead materialize the literal's own category and
     checked-convert it, so real32 x := 5 and int y := 3.0 are valid;
   - in a nat or int context an integer literal has no width ceiling; fixed-width
     contexts keep their ranges; a real literal rounds correctly to realN and is
     exact for real;
   - AND, OR, XOR, NOT, <<, >> apply only to nat8..nat64 and int8..int64.
     Lowercase and/or/not remain bool-only logical operators. *)

(* Static/frontend constraints:
   - import is top-level only; imported modules contain declarations and may contain
     top-level if main guards, whose bodies are checked but inactive when imported;
     other executable top-level statements are root-only;
   - top-level function/class names are downward-visible unless introduced earlier by
     a same-file prototype; ';' is reserved for those prototypes, which require one
     matching later definition; methods and enums do not have prototype forms;
   - standard namespaces are always visible and cannot be imported;
   - unquoted non-standard import targets name installed packages; quoted ./ and ../
     imports are importer-relative and quoted @/ imports are command-working-directory-relative;
   - import cycles and alias collisions are invalid;
   - cli_decl is root-only, occurs at most once, and its fields use
     argument(), trailing argument(default = value), option(default = value), or flag();
     required positional argument() fields must precede optional positional fields;
   - initialized declarations, assignments, parameter defaults, returns and value
     arguments use checked conversion between numeric types: range checks, defined
     destination rounding and integral-only real-to-integer conversion. Complex
     values do not convert to real/integer. References retain exact storage types;
     bool never implicitly converts to or from numbers. Conditions, lowercase
     logical operands and bool value arguments require bool;
   - a contextual scalar range first determines its storage type, evaluates its
     candidate and each bound at most once, converts the candidate, validates it,
     and only then commits a guarded write. Proven failures are compile errors;
     other failures stop with RANGE_CONSTRAINT, including in release builds.
     Parameter ranges are entry preconditions; class-header ranges check generation
     inputs and do not establish permanent member invariants;
   - `tensor<T>{AXIS, ...}` uses a mandatory fixed-width native numeric element type plus an
     optional shape pattern; each explicit axis is `_`, a shape-variable declaration,
     an ordered range constraint or a numeric expression checked as a nat extent.
     Boolean expressions never supply numeric extents. Without `...`, the number of axes is the required rank; one `...` permits
     zero or more middle axes, with preceding constraints aligned from the head and following
     constraints aligned from the tail. Rank must be at least the number of explicit axes; Integer expressions
     that are not compile-time constants are evaluated once when the binding is
     created and their nonnegative results are captured for that binding;
   - a shape in braces, `tensor<T>{AXIS, ...}`, gives the roles of the four bracket
     kinds: `<...>` the element type, `{...}` the shape, `[...]` an index or a slice,
     `(...)` a call; outside string literals, `{` and `}` appear only in shapes, and
     `tensor` is always followed by `<T>`. An axis is `nat N` (a new shape variable,
     the axis's extent), `N := EXPR` (a new shape variable equal to EXPR), a bare
     name (an existing shape variable or numeric value convertible to nat: the axis equals it), `_` (an
     extent of any length that binds nothing) or any other numeric expression (the
     axis equals its checked conversion to nat); `nat N := EXPR` is the explicit spelling of `N := EXPR`.
     A range around nat N captures the actual incoming extent before checking its bounds;
     a range around existing x retains axis == nat(x) plus the scalar range check.
     Two untyped names, x < y, select x as the subject. Only a lone identifier is a bare name, and
     `(n)` is an expression. Every extent is nat: evaluate each expression once at its
     original static type, then convert only the result with explicit nat-cast checks.
     Negative or fractional results fail. A bare name that names nothing, or a
     value that cannot convert to nat, is an error; declaring a visible name is SHADOWING, and declaring one twice in a
     shape is an error (`{nat N, N}` is square). A shape is one scope unit: an axis may
     use any variable of its shape whatever the textual order, `N := EXPR` axes are
     evaluated in dependency order, and a cycle is an error. Shape variables are
     read-only nat values, scoped like bindings and reused by bare name; without an
     initializer a declaration has no `nat N` capture, constrained or otherwise.
     Captured extents fix the binding's shape contract even when source variables later
     change. Bindings, match cases, function/method/class signatures, extern declarations
     and func types use these axis forms. A signature is one scope unit for its parameter
     captures and derived result extents; a bare nat capture in a result cannot infer a
     value. A shape-match predicate mismatch selects the next case instead of aborting;
   - array dimensions use the same integer-expression rule. `[]` remains a
     runtime-sized dimension, while `[expr]` captures expr once for the binding;
   - generic classes require explicit type arguments in type positions; a
     construction call may omit them when the constructor's arguments uniquely
     determine every class type parameter; generic function/method
     type arguments may be omitted when every generic parameter is uniquely inferred
     from call arguments; all concrete uses are monomorphized before ordinary static checking;
   - `func<R(P...)>` is a capture-free function-value type. Converting a declared
     function to it requires a complete function-value context and an exact
     by-value signature. A generic call with a declared func parameter can infer
     type arguments from a named non-generic callback. Extern functions,
     reference-parameter functions, and bound
     methods do not implicitly become function values;
   - `T(...)` runs the class header and ordered initialization body. Header defaults
     or free factories express alternate forms; `construct` is an ordinary name.
     To declare an instance and construct it, write `T name := T(args)`.
     A bare class binding has no accessible instance until whole-value initialization;
     standard `map<K, V>` and `distinct<T>` bare bindings retain initialized empty storage;
   - a required parameter and an uninitialized field need explicit types. The default
     or initializer must determine a unique type when the type is omitted.
   - omitting the type in an initialized declaration infers the non-`error` success side and
     fails fast if the initializer produces `error`. An explicit union type including
     `error` retains that failure channel;
   - class members are public by default. private limits a member to its declaring class; top-level private limits a declaration to its module;
   - a string literal placeholder `{&storage}` is an input target and is valid only as
     the format of scan(...); print, flush and scan return void | error, and an
     expression statement whose value can be error fails fast on error;
   - `public import` re-exports the imported alias as a nested namespace of the module;
   - class members use their bare names; an optional header instance name denotes
     the fixed whole instance and cannot be replaced or escape during initialization;
     `this` has no implicit meaning. local before const/type declares a temporary,
     scoped from its declaration through inner control blocks, never another definition;
   - `_` is the discard name, not a reserved word: it is never declared (as a binding,
     parameter, field, function, method, class, enum, variant, type parameter, match
     binder, loop name or import alias) and never read; in a brace tensor shape it is
     an axis of any extent;
   - identifiers that begin with `__quidra_` are reserved for the compiler and are never
     declared;
   - `export` is contextual: it begins an export_decl only at top level and only when a
     string literal follows it; elsewhere it is an ordinary identifier. The string is
     "C". An export_decl prefixes a non-generic free function, never a method,
     constructor or class member, and is not valid inside a block. When an exported
     function has a prototype, the prototype and the definition both carry the prefix;
   - an if-expression's condition and branches are or_expr: an if-expression nested there,
     or used as an operand, is parenthesized, and a branch extends as far as an or_expr, so
     `if c then 2 else 3 + 1` is `if c then 2 else (3 + 1)`; `else` is mandatory and
     `else if` is written `elif`; a statement that begins with `if` is an if_stmt (or the
     `if main` guard), never an expression statement; statement headers are or_expr, so an
     if-expression there is parenthesized; outside brackets an if-expression ends with its
     line; it gives a value, never a reference (no `&` before it, no reference binding to it,
     no address as a branch); `then` is reserved;
   - a slice item is `[start:end:step]`. Each side is inclusive (no marker) or exclusive
     (a marker): the start side `s<:` (ascending) or `s>:` (descending), the end side
     `:<e` (ascending) or `:>e` (descending). A marker is a `<` or `>` written directly
     next to the first colon of the item, with no whitespace between; anywhere else `<`
     and `>` are comparisons, and a comparison inside parentheses, brackets or an
     argument list belongs to no slice. A marker after the final `else` branch of an
     if-expression marks the whole if-expression. An exclusive marker needs its value
     (`s<:`, `s>:`, `:<e`, `:>e`), and no marker belongs to the second colon (the step);
     `<=` and `>=` are never markers;
   - a slice's direction comes from its markers (`<` ascending, `>` descending), else from
     its step's sign, else from its two explicit bounds (descending when start > end,
     ascending otherwise); with omitted bounds and no step it ascends.
     Two markers that point different ways, and a marker
     against the step's sign, are errors, and so is a step of 0. The default step is +1
     ascending and -1 descending. The start is the anchor of the progression
     start, start + step, ...; an exclusive start drops the anchor itself;
   - standalone bounded ranges use the same endpoint markers and anchor progression.
     The start defaults to zero, the end is required, and both bounds have one integer
     element type. A nonzero explicit step agrees with any markers and with unequal
     bounds. Equal bounds permit either step sign when no marker fixes the direction.
     Without an explicit step, reversed markers give an empty exclusive progression.
     Equal inclusive bounds give one element; an exclusive endpoint gives an empty array. Arbitrary-precision
     int/nat bounds and integer steps remain exact;
   - safe address targets, exhaustive cases, field-level initialization, fixed shapes,
     argument ordering, value equality, and
     no-shadowing are checked statically.
   '&' forms safe storage addresses. print may observe the current raw machine
     address, and ==/!= may compare address identity; addresses are otherwise non-storable
     and do not support conversion, arithmetic, ordering, or dereference;
   - `const T` is an immutable value; `T &` is the only reference form, and `const T &`
     is rejected (CONST_REFERENCE). const value bindings require initialization; a const
     parameter takes a value at the call, never `&storage`. *)

(* Tuple type and literal atoms: at least two elements, no trailing comma.
   A single element in parentheses is a grouped type or expression. *)
tuple_type = "(", type, ",", type, { ",", type }, ")" ;
tuple_expr = "(", tuple_values, ")" ;
tuple_values = expression, ",", expression, { ",", expression } ;

destructuring = [ "local" ], ( new_pattern | bare_new_pattern ), ":=",
                ( "&", expression | expression | tuple_values ), statement_end
              | ( place_pattern | place_elements ), "=", ( expression | tuple_values ), statement_end ;
bare_new_pattern = identifier, ",", identifier, { ",", identifier } ;
new_pattern = "(", new_element, ",", new_element, { ",", new_element }, ")" ;
new_element = [ "const" ], [ type ], [ "&" ], identifier | "_" | new_pattern ;
place_pattern = "(", place_elements, ")" ;
place_elements = place_element, ",", place_element, { ",", place_element } ;
place_element = "_" | place_pattern | assignable ;

(* Standalone destructuring statements may omit outer parentheses as specified
   above. Parentheses group nested patterns and tuple values inside expressions.
   Ungrouped commas do not continue a logical line. *)

(* Collection for headers also accept a declaration, existing-place or reference
   tuple pattern. Reference patterns take &SOURCE[]. *)

