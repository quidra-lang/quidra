print("ADV-START")
io.flush()
string read_input_line()
    string line = ""
    void | error read = scan(&line)
    match read
        void
            return line
        error problem
            process.exit(2)
int a = int.parse(read_input_line())
int32 v = int32(a)
print("OBS=V:{v}")
io.flush()
print("ADV-END")
io.flush()
