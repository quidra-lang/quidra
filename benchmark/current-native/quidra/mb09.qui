// CURRENT-EQUIVALENT DIAGNOSTIC: renames the frozen local `bin` because `bin` is now a reserved type name; workload semantics are unchanged.
// MB-09 statistics: two-pass moments, Pearson correlation, and a 64-bin histogram.
//
// Mode selection (methodology 06 section 5.2). Quidra's `cli` module has no
// OPTIONAL positional argument: `argument()` is positional but mandatory (a bare
// `./BIN` then exits with CLI status 2, which would break the frozen `once`
// recipe), and `option(default = ...)` is optional but named. The optional form
// is the one that preserves section 5.2's semantics, so the mode is spelled
// `--mode steady --iters K` instead of `argv[1] argv[2]`.
//
// Section 5.2 also requires each ITER line to be flushed immediately, and
// Quidra v0.1 cannot do that: `print` lowers to C `puts` on block-buffered
// stdout (quidra/src/llvm_backend.cpp:2195, :2202, :2209; `declare i32 @puts`
// at :2829) and the standard library exposes no flush call. Measured: this
// program run in steady mode with stdout redirected to a file and SIGKILLed
// after three iterations had completed produced 0 bytes of output. Section
// 5.4's partial-retention rule (rule 1) is therefore inert for this
// configuration; a steady process stopped at the timeout falls to rule 2.

cli args
    string mode = option(default = "once")
    int iters = option(default = 7)

class Lcg
    int state

    int next_int()
        state = (48271 * state) % 2147483647
        return state

    float next_unit()
        return float(next_int()) / 2147483647.0

class Result
    float mean = 0.0
    float variance = 0.0
    float deviation = 0.0
    float minimum = 0.0
    float maximum = 0.0
    float mean_absolute = 0.0
    float pearson = 0.0
    int histogram_check = 0

Result workload()
    const int count = 2000000
    const int rounds = 30

    Lcg generator = Lcg(state = 20269917)

    float[] xs = array(count, fill = 0.0)
    for i in range(0, count)
        xs[i] = generator.next_unit() * 100.0

    float[] ys = array(count, fill = 0.0)
    for i in range(0, count)
        ys[i] = generator.next_unit() * 100.0

    float elements = float(count)
    float mean = 0.0
    float variance = 0.0
    float deviation = 0.0
    float minimum = 0.0
    float maximum = 0.0
    float mean_absolute = 0.0
    float pearson = 0.0
    int histogram_check = 0

    for round in range(0, rounds)
        xs[round] += 1.0e-9

        // pass 1: sum, minimum, maximum
        float sum = 0.0
        minimum = xs[0]
        maximum = xs[0]
        for i in range(0, count)
            float v = xs[i]
            sum += v
            if v < minimum
                minimum = v
            if v > maximum
                maximum = v
        mean = sum / elements

        // pass 2: squared and absolute deviations about the mean
        float squares = 0.0
        float absolutes = 0.0
        for i in range(0, count)
            float d = xs[i] - mean
            squares += d * d
            absolutes += math.abs(d)
        variance = squares / elements
        deviation = math.sqrt(variance)
        mean_absolute = absolutes / elements

        // pass 3: mean of the second series
        float sum_y = 0.0
        for i in range(0, count)
            sum_y += ys[i]
        float mean_y = sum_y / elements

        // pass 4: two-pass Pearson correlation
        float sxy = 0.0
        float sxx = 0.0
        float syy = 0.0
        for i in range(0, count)
            float dx = xs[i] - mean
            float dy = ys[i] - mean_y
            sxy += dx * dy
            sxx += dx * dx
            syy += dy * dy
        pearson = sxy / math.sqrt(sxx * syy)

        // pass 5: histogram
        int[] histogram = array(64, fill = 0)
        for i in range(0, count)
            int bucket = math.floor(xs[i] * 0.64)
            if bucket < 0
                bucket = 0
            if bucket > 63
                bucket = 63
            histogram[bucket] += 1
        histogram_check = 0
        for bucket in range(0, 64)
            histogram_check += (bucket + 1) * histogram[bucket]

    return Result(mean = mean, variance = variance, deviation = deviation,
                  minimum = minimum, maximum = maximum,
                  mean_absolute = mean_absolute, pearson = pearson,
                  histogram_check = histogram_check)

Result out = Result()
if args.mode == "steady"
    for k in range(0, args.iters)
        time.Instant started = time.now()
        out = workload()
        time.Duration elapsed = time.since(started)
        int nanoseconds = math.floor(elapsed.seconds() * 1000000000.0)
        print("ITER {k} {nanoseconds}")
else
    out = workload()
print("MB09 mean={out.mean:sig=17} var={out.variance:sig=17} sd={out.deviation:sig=17} min={out.minimum:sig=17} max={out.maximum:sig=17} mad={out.mean_absolute:sig=17} pearson={out.pearson:sig=17} hist_chk={out.histogram_check}")
