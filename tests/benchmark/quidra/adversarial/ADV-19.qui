print("ADV-START")
io.flush()
string read_input_line()
    string | none | error line = input()
    match line
        string text
            return text
        none
            process.exit(2)
        error problem
            process.exit(2)
int f(int n)
    return 1 + f(n + 1)
int start = int.parse(read_input_line())
int result = f(start)
print("OBS=R:{result}")
io.flush()
print("ADV-END")
io.flush()
