print("ADV-START")
print(NL)
flush()
string read_input_line()
    string line = ""
    void | error read = scan(&line)
    match read
        void
            return line
        error problem
            process.exit(2)
int pick(bool flag)
    if flag
        return 1
string text = read_input_line()
bool flag = text == "1"
int product = pick(flag) * 2
print("OBS=R:{product}")
print(NL)
flush()
print("ADV-END")
print(NL)
flush()
