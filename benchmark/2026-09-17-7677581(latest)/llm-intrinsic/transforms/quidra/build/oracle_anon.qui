lisutu state = 7
lisutu total = 0
lisutu largest = 0
lisutu evens = 0
febole joined = ""
betede i kurodi range(0, 50)
    state = state * 48271 % 2147483647
    lisutu term = state % 1000
    total = total + term
    kimeke term > largest
        largest = term
    kimeke term % 2 == 0
        evens = evens + 1
    kimeke i < 5
        kimeke i == 0
            joined = "{term}"
        togapi
            joined = joined + "-" + "{term}"
print("SUM {total}")
print("MAX {largest}")
print("EVENS {evens}")
print("JOINED {joined}")
