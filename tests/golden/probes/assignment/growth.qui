// A compound assignment whose right-hand side grows the target's array
// stores into the grown array, like the plain assignment beside it.
int grow(int[] &values)
    for i in range(1000)
        values = values.append(i)
    return 1

int[] a = [5, 0, 0]
a[0] = a[0] + grow(&a)
print("plain: {a[0]} {len(a)}")
print(NL)
int[] b = [5, 0, 0]
b[0] += grow(&b)
print("compound: {b[0]} {len(b)}")
print(NL)
int[] c = [5, 3, 2]
c[2] *= grow(&c) + 1
print("product: {c[2]} {c[3]} {len(c)}")
print(NL)
