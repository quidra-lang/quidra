print("ADV-START")
io.flush()
string read_input_line()
    string line = ""
    void | error read = scan(&line)
    match read
        void
            return line
        error problem
            process.exit(2)
int32 a = int32.parse(read_input_line())
uint32 b = uint32.parse(read_input_line())
bool r = a < b
print("OBS=CMP:{r}")
io.flush()
print("ADV-END")
io.flush()
