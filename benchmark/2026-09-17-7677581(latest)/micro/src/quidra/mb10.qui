// MB-10 file I/O: write three ASCII text files line by line and read them back.
//
// Quidra 0.1 exposes only whole-file text I/O (`file.write` / `file.read`); the
// standard library has no incremental writer, no append mode and no buffered
// line reader. The read-back splits the whole-file text the same way. This is
// Quidra's normal file I/O, not a shortcut around a buffered writer it does not
// have.
//
// FORCED SUBSTITUTION for section 4.12(c)'s "content accumulated in a `string`",
// and for the pseudocode's `line = decimal(i) + " " + decimal(v) + "\n"`.
// Quidra v0.1's native backend emits the `+` string operator as a stack
// allocation AT THE INSTRUCTION SITE -- `alloca ptr, i64 N` for the operand
// vector, quidra/src/llvm_backend.cpp:769-770 (StringConcat) and :784-785
// (StringAppendMove). Inside a loop that alloca is not in the entry block, so
// neither mem2reg nor SROA can promote it and the stack grows by ~16 bytes per
// EXECUTION until the guard page is hit. The failure is driven by iteration
// count, not by string length. Measured on this host with `quidra build` and a
// bare `./BIN`:
//   for i in range(0, 700000): string line = "ab" + "cd"   (result discarded)
//       -> SIGSEGV 139, crash report "Thread stack size exceeded";
//   the same loop written with ["ab", "cd"].join("")       -> exit 0;
//   the same `+` binary under `ulimit -s 65520`            -> exit 0, 3/3.
// MB-10 formats 1 000 000 lines per round, well past the ~500 000-execution
// ceiling, so neither the pinned per-line `+` nor the pinned
// `content = content + line` accumulation can run at this workload's size at
// all. Raising the stack limit is outside the frozen run recipe (specification
// section 32). Both therefore use `string[]` + `join`, the language's other
// ordinary string builder and the one docs/spec/language.md describes as
// constructing the result in one operation. This is a defective-capability
// result, not an implementation choice.
//
// Mode selection (methodology 06 section 5.2). Quidra's `cli` module has no
// OPTIONAL positional argument: `argument()` is positional but mandatory (a bare
// `./BIN` then exits with CLI status 2, which would break the frozen `once`
// recipe), and `option(default = ...)` is optional but named. The optional form
// is the one that preserves section 5.2's semantics, so the mode is spelled
// `--mode steady --iters K` instead of `argv[1] argv[2]`.
//
// Section 5.2 also requires each ITER line to be flushed immediately, and
// Quidra v0.1 cannot do that: `print` lowers to C `puts` on block-buffered
// stdout (quidra/src/llvm_backend.cpp:2195, :2202, :2209; `declare i32 @puts`
// at :2829) and the standard library exposes no flush call. Measured: this
// program run in steady mode with stdout redirected to a file and SIGKILLed
// after three iterations had completed produced 0 bytes of output. Section
// 5.4's partial-retention rule (rule 1) is therefore inert for this
// configuration; a steady process stopped at the timeout falls to rule 2.

cli args
    string mode = option(default = "once")
    int iters = option(default = 7)

void write_text(string path, string content)
    match file.write(path, content)
        void
            return
        error problem
            print("MB10 write failed: {problem}")
            process.exit(1)

string read_text(string path)
    match file.read(path)
        string text
            return text
        error problem
            print("MB10 read failed: {problem}")
            process.exit(1)

int parse_decimal(string text)
    match int.parse(text)
        int value
            return value
        error problem
            print("MB10 parse failed: {problem}")
            process.exit(1)

class Result
    int sum_v = 0
    int check = 0
    int written_bytes = 0
    int line_count = 0

Result workload()
    const int count = 1000000
    const int rounds = 3
    int state = 20270917

    int sum_v = 0
    int check = 0
    int written_bytes = 0
    int line_count = 0

    for round in range(0, rounds)
        string[] name_parts = ["mb10_round_", round.string(), ".txt"]
        string name = name_parts.join("")

        string[] rows = []
        for i in range(0, count)
            state = (state * 48271) % 2147483647
            string[] fields = [i.string(), " ", state.string(), enter]
            string line = fields.join("")
            rows = rows.append(line)
            written_bytes += len(line)
        write_text(name, rows.join(""))

        string text = read_text(name)
        string[] lines = text.split(enter)
        int index = 0
        for line in lines
            if len(line) == 0
                continue
            string[] fields = line.split(" ")
            int a = parse_decimal(fields[0])
            int v = parse_decimal(fields[1])
            if a != index
                print("MB10 index mismatch at {index}")
                process.exit(1)
            index += 1
            line_count += 1
            sum_v = (sum_v + v) % 1000000007
            check = (check * 31 + v % 1000003) % 1000003

    return Result(sum_v = sum_v, check = check,
                  written_bytes = written_bytes, line_count = line_count)

Result out = Result()
if args.mode == "steady"
    for k in range(0, args.iters)
        time.Instant started = time.now()
        out = workload()
        time.Duration elapsed = time.since(started)
        int nanoseconds = math.floor(elapsed.seconds() * 1000000000.0)
        print("ITER {k} {nanoseconds}")
else
    out = workload()
print("MB10 {out.sum_v} {out.check} {out.written_bytes} {out.line_count}")
