print("ADV-START")
io.flush()
string read_input_line()
    string | none | error line = input()
    match line
        string text
            return text
        none
            process.exit(2)
        error problem
            process.exit(2)
uint32 a = uint32.parse(read_input_line())
uint32 b = uint32.parse(read_input_line())
uint32 r = a - b
print("OBS=SUB:{r}")
io.flush()
print("ADV-END")
io.flush()
