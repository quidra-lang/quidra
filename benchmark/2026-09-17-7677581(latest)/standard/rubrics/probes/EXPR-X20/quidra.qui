string open = "{{"
string close = "}}"
string doc = "{quote}name{quote}: {quote}alice{quote}, {quote}age{quote}: 30"
string text = open + doc + close
auto parsed = json.parse(text)
match parsed
    json.Value v
        auto namev = v.get("name")
        auto agev = v.get("age")
        match namev
            json.Value nv
                match agev
                    json.Value av
                        auto nt = nv.text()
                        auto ai = av.integer()
                        match nt
                            string s
                                match ai
                                    int n
                                        print("X20 {s} {n} {v.encode()}")
                                    error e5
                                        print("X20 int-error")
                            error e4
                                print("X20 text-error")
                    none
                        print("X20 no age")
                    error e3
                        print("X20 age-error")
            none
                print("X20 no name")
            error e2
                print("X20 name-error")
    error e
        print("X20 parse-error")
