// A reference loop over a `&` parameter while the body appends to the same
// array through another `&` parameter: FOR_ITERATION at the assignment.
void walk(int[] &a, int[] &b)
    for &x in a
        b = b.append(9)
        x = x + 100

int[] v = [1, 2, 3]
print("before" + NL)
walk(&v, &v)
print("after" + NL)
