// A value loop that took a copy of the iterated array releases it at
// every exit: its end, break, return, and a `try` propagation.
int first_over(int[] &values, int limit)
    for v := values[]
        values = values.append(v)
        if v > limit
            return v
    return 0

int | error checked_sum(int[] &values)
    int total := 0
    for v := values[]
        values[0] = 0
        total = total + (try int("{v}"))
        if v == 3
            int bad := try int("x")
            total = total + bad
    return total

int[] values := [1, 2, 3, 4]
print("return: {first_over(&values, 2)} {values.len()}")
print(NL)
int[] more := [1, 2, 3, 4]
int count := 0
for v := more[]
    more = more.append(v)
    count = count + 1
    if v == 2
        break
print("break: {count} {more.len()}")
print(NL)
int[] parsed := [1, 2, 3]
int | error result := checked_sum(&parsed)
match result
    int sum
        print("sum: {sum}")
    error
        print("try: {parsed[0]}")
print(NL)
for: 0 <= nat round < 3
    int[] inner := [int(round), int(round)]
    for v := inner[]
        inner = inner.append(v)
    print("{inner.len()} ")
print(NL)
