print("ADV-START")
print(NL)
flush()
string read_input_line()
    string line = ""
    void | error read = scan(&line)
    match read
        void
            return line
        error problem
            process.exit(2)
real64 a = real64.parse(read_input_line())
real64 b = real64.parse(read_input_line())
real64 m = a / b
real64[] xs = [3.0, m, 1.0]
real64 best = xs[0]
for i in range(1, 3)
    real64 x = xs[i]
    if x > best
        best = x
bool selfeq = m == m
print("OBS=MAX:{best:frac=6}|SELFEQ:{selfeq}")
print(NL)
flush()
print("ADV-END")
print(NL)
flush()
