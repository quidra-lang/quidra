class Point
    int x = 1
    int y = 2

    int sum()
        return x + y

class ShiftedPoint : Point
    int offset = 1

    override int sum()
        return super.sum() + offset

Point a = Point()
Point b = Point(x = 1)
ShiftedPoint shifted = ShiftedPoint()

int[] left = [1, 2, 3]
int[] right = [1, 2, 3]

print(a == b)
print(left == right)
print(shifted.sum())
