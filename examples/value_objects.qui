class Point(local int x_initial := 1)
    int x := 1
    int y := 2


    x = x_initial

    int sum()
        return x + y

class ShiftedPoint()
    point := Point()
    int offset := 1

    int sum()
        return point.sum() + offset

a := Point()
a.x = 1
a.y = 2
b := Point(1)
shifted := ShiftedPoint()

int[] left := [1, 2, 3]
int[] right := [1, 2, 3]

println(a == b)
println(left == right)
println(shifted.sum())
