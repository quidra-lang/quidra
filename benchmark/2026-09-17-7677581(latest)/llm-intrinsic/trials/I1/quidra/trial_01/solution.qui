// Park-Miller minimal-standard generator, 50 terms
int state = 7
int term = 0
int total = 0
int largest = 0
int evens = 0
string chain = ""
for i in range(0, 50)
    state = state * 48271 % 2147483647
    term = state % 1000
    total = total + term
    if term > largest
        largest = term
    if term % 2 == 0
        evens = evens + 1
    if i == 0
        chain = "{term}"
    elif i < 5
        chain = chain + "-" + "{term}"
print("SUM {total}")
print("MAX {largest}")
print("EVENS {evens}")
print("JOINED {chain}")
