string | error next_line()
    auto received = try input()
    match received
        string text
            return text
        none
            return error("no line")

int64 f(int64 n)
    if n == 1000000
        return 0
    return 1 + f(n + 1)

void | error run()
    int64 start = try int64.parse(try next_line())
    int64 result = f(start)
    print("OBS=R:{result}")
    return void

print("ADV-START")
run()
print("ADV-END")
