string | error next_line()
    auto received = try input()
    match received
        string text
            return text
        none
            return error("no line")

void | error run()
    int32 signed_value = try int32.parse(try next_line())
    uint32 unsigned_value = try uint32.parse(try next_line())
    bool outcome = signed_value < unsigned_value
    print("OBS=CMP:{outcome}")
    return void

print("ADV-START")
run()
print("ADV-END")
