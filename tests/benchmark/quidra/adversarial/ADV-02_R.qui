print("ADV-START")
io.flush()
string read_input_line()
    string line = ""
    void | error read = scan(&line)
    match read
        void
            return line
        error problem
            process.exit(2)
int x = int.parse(read_input_line())
int s = x + 3
print("OBS=V:{s}")
io.flush()
print("ADV-END")
io.flush()
