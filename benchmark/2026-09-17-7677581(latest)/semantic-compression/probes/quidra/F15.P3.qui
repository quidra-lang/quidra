// BEGIN PROBE F15.P3
class Named
    string tag()
        return ""

class A : Named
    override string tag()
        return "a"

class B : Named
    override string tag()
        return "b"

T[] two<T>(T u, T v)
    return [u, v]

auto items = two<A | B>(A(), B())
string first
match items[0]
    A x
        first = x.tag()
    B y
        first = y.tag()
// END PROBE F15.P3

print(first)
