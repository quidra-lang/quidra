print("ADV-START")
io.flush()
string read_input_line()
    string | none | error line = input()
    match line
        string text
            return text
        none
            process.exit(2)
        error problem
            process.exit(2)
int scale(int value)
    return value * 3
string text = read_input_line()
int result = scale(text)
print("OBS=R:{result}")
io.flush()
print("ADV-END")
io.flush()
