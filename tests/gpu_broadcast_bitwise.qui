// Prints every forward value and every gradient of broadcast, transposed,
// stepped and scalar tensor arithmetic, exactly (shortest round-trip text of
// each float32). The GPU suites run it twice and require identical output:
// the strided device path (QUIDRA_BROADCAST=strided) against
// QUIDRA_BROADCAST=gather (host-built gather indices), and on the test
// backend also the GPU against the CPU.
//
//     quidra tests/gpu_broadcast_bitwise.qui --device N
cli args
    int device = option(default = -1)

int element_count(int[] shape)
    int count = 1
    for extent in shape
        count = count * extent
    return count

tensor<real32> place(tensor<real32> value, int device)
    if device >= 0
        return value.gpu(nat(device))
    return value

// Deterministic values with varied mantissas; `positive` keeps divisors away
// from zero.
tensor<real32> values(int[] shape, int seed, bool positive, int device)
    int count = element_count(shape)
    tensor<real32> flat = tensor.zeros<real32>([nat(count)])
    for index in range(count)
        int raw = ((index + 1) * 7919 + seed * 104729) % 2003
        real32 lower = real32(raw - 1001)
        real32 upper = real32(raw + 1)
        real32 value = lower / real32(37)
        if positive
            value = upper / real32(37)
        flat[index] = value
    return place(flat.reshape(nat(shape)), device)

void dump(string label, tensor<real32> value)
    tensor<real32> host = value.cpu()
    int count = element_count(int(host.shape()))
    tensor<real32> flat = host.contiguous().reshape([nat(count)])
    print("{label}:")
    for index in range(count)
        print(" {real64(flat[index].item())}")
    print(NL)

void dump_int(string label, tensor<int32> value)
    tensor<int32> host = value.cpu()
    int count = 1
    for extent in host.shape()
        count = count * int(extent)
    tensor<int32> flat = host.contiguous().reshape([nat(count)])
    print("{label}:")
    for index in range(count)
        print(" {int(flat[index].item())}")
    print(NL)

// A scalar loss through scatter (one serial sum) so that gradients reach the
// operands without a long gather chain.
tensor<real32> total(tensor<real32> value)
    int count = element_count(int(value.shape()))
    int[] zeros = array(nat(count), fill = 0)
    return value.reshape([nat(count)]).scatter(zeros, [1])

tensor<real32> apply(tensor<real32> left, tensor<real32> right, int operation)
    if operation == 0
        return left + right
    if operation == 1
        return left - right
    if operation == 2
        return left * right
    return left / right

void check_pair(string name, tensor<real32> left, tensor<real32> right, int device)
    for operation in range(4)
        tensor<real32> left_value = left
        tensor<real32> right_value = right
        if operation == 3
            right_value = right * right + real32(0.5)
        tensor<real32> output = apply(left_value.track(), right_value.track(), operation)
        dump("{name} op{operation} forward", output.untrack())
        tensor<real32> weights = values(int(output.shape()), operation + 11, false, device)
        total(output * weights).backward(&left_value, &right_value)
        dump("{name} op{operation} left", left_value.grad)
        dump("{name} op{operation} right", right_value.grad)
        // One operand tracked: only the needed partial derivative is kept.
        tensor<real32> left_only = left
        tensor<real32> right_only = right_value
        total(apply(left_only.track(), right_value, operation) * weights).backward(&left_only)
        dump("{name} op{operation} left only", left_only.grad)
        total(apply(left_value, right_only.track(), operation) * weights).backward(&right_only)
        dump("{name} op{operation} right only", right_only.grad)

void check_shapes(string name, int[] left_shape, int[] right_shape, int seed, int device)
    check_pair(name, values(left_shape, seed, false, device), values(right_shape, seed + 1, false, device), device)

void check_scalars(string name, tensor<real32> source)
    tensor<real32> value = source
    tensor<real32> x = value.track()
    dump("{name} add", (x + real32(1.25)).untrack())
    dump("{name} rsub", (real32(3) - x).untrack())
    dump("{name} mul", (x * real32(0.3)).untrack())
    dump("{name} div", (x / real32(7)).untrack())
    dump("{name} rdiv", (real32(5) / (x * x + real32(1))).untrack())
    dump("{name} pow", (x ^ real32(3)).untrack())
    tensor<real32> combined = (real32(5) - x * real32(3)) / real32(2) + x ^ real32(2)
    total(combined).backward(&value)
    dump("{name} grad", value.grad)

check_shapes("row", [4, 3], [1, 3], 1, args.device)
check_shapes("column", [4, 3], [4, 1], 3, args.device)
check_shapes("both", [1, 3], [4, 1], 5, args.device)
check_shapes("rank3", [2, 3, 4], [1, 3, 1], 7, args.device)
check_shapes("rank3-outer", [2, 1, 4], [1, 3, 1], 9, args.device)
check_shapes("fc-bias", [45, 2], [1, 2], 11, args.device)
check_shapes("long", [130, 3], [1, 3], 13, args.device)
check_shapes("scalar-shape", [1, 1], [3, 5], 17, args.device)
check_shapes("rank0", [], [], 19, args.device)
check_shapes("zero-rows", [0, 3], [0, 1], 20, args.device)
check_shapes("zero-columns", [3, 0], [1, 0], 28, args.device)
check_shapes("zero-singleton", [0, 3], [1, 3], 30, args.device)
check_shapes("singleton-zero", [1, 3], [0, 3], 32, args.device)
check_shapes("zero-both", [0, 1], [1, 4], 34, args.device)

tensor<real32> grid = values([3, 4], 21, false, args.device)
check_pair("transposed", grid.transpose(0, 1), values([4, 3], 22, false, args.device), args.device)
check_pair("transposed-broadcast", grid.transpose(0, 1), values([1, 3], 23, false, args.device), args.device)
tensor<real32> line = values([9], 24, false, args.device)
check_pair("stepped", line[0:9:2], values([5], 25, false, args.device), args.device)
check_pair("offset-row", values([3, 4], 26, false, args.device)[1:2, 0:4], values([5, 4], 27, false, args.device), args.device)

check_scalars("transposed-scalar", grid.transpose(0, 1))
check_scalars("stepped-scalar", line[1:9:3])
check_scalars("empty-scalar", values([0, 3], 29, false, args.device))

tensor<int32> integers = tensor.zeros<int32>([4, 3])
for row in range(4)
    for column in range(3)
        integers[row, column] = int32(row * 17 - column * 5 + 3)
tensor<int32> divisors = tensor.ones<int32>([1, 3]) * int32(4)
divisors[0, 1] = int32(-3)
if args.device >= 0
    integers = integers.gpu(nat(args.device))
    divisors = divisors.gpu(nat(args.device))
dump_int("int add", integers + divisors)
dump_int("int mul", divisors * integers)
dump_int("int div", integers / divisors)
dump_int("int rem", integers % divisors)
dump_int("int transposed", integers.transpose(0, 1) - int32(2))
