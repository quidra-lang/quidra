int value := 255
int negative := -255
large := nat.parse("18446744073709551616")
print.line("bin={value.string(base = 2)}")
print.line("oct={value.string(base = 8)}")
print.line("hex={value.string(base = 16, uppercase = true)}")
print.line("signed={negative.string(base = 16, uppercase = true)}")
print.line("large={large.string(base = 16, uppercase = true)}")
print.line("interp-bin={value:base=2}")
print.line("interp-hex={value:base=16,upper}")
print.line("interp-large={large:base=16,upper}")
