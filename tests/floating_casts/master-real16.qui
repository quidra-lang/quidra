tensor<real32> master := (tensor.ones<real32>([]) * real32(1.00048828125)).track()
tensor<real16> low := real16(master)
print(low.untrack().item() == real16(1))
print(NL)
tensor<real16> loss := low * real16(1.0009765625)
loss.backward(&master)
print(master.grad.item() == real32(1.0009765625))
print(NL)
loss.backward(&master)
print(master.grad.item() == real32(2.001953125))
print(NL)
