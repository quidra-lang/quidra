class Point
    int x
    int y

    construct(int x, int y)
        this.x = x
        this.y = y

    int sum()
        return this.x + this.y

    int doubled()
        return sum() * 2

class LabeledPoint
    Point point
    string label

    construct(Point point, string label)
        this.point = point
        this.label = label

    int sum()
        return this.point.sum()

class OffsetPoint
    Point point
    int offset

    construct(Point point, int offset)
        this.point = point
        this.offset = offset

    int sum()
        return this.point.sum() + this.offset

class Box
    Point point

    construct(Point point)
        this.point = point

class Counter
    int value

    construct(int value)
        this.value = value

    void increment()
        this.value = this.value + 1

Point a = Point(1, 2)
Point b = a
b.x = 9

Point &alias = &a
alias.y = 5

LabeledPoint labeled = LabeledPoint(Point(3, 4), "p")
OffsetPoint offset = OffsetPoint(Point(3, 4), 10)

Box box = Box(a)
Box copy = box
copy.point.x = 99

Counter counter = Counter(1)
counter.increment()

