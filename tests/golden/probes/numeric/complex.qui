// Complex values of every kind: literals, parts, the four operations
// (Smith's division), equality, a conversion, text and a tensor.
com64 a := 1.0 + 2.0i
com64 c := 3.0 - 1.0i
com32 x := com32(real32(1.5)) - 0.25i
com16 h := 0.1 + 0.1i
com16b b := 1.0 - 3.0i
com exact := 0.5 + 0.25i
print("{a + c} {a - c} {a * c} {a / c} {-a} {a == c}")
print(NL)
print("{x * x} {h * h} {b / b} {exact * exact} {a.real} {x.imag}")
print(NL)
tensor<com32> t := tensor.ones<com32>([2]) * (2.0 + 1.0i)
print((t * t)[1].item())
print(NL)
