print("ADV-START")
print(NL)
flush()
string read_input_line()
    string line = ""
    void | error read = scan(&line)
    match read
        void
            return line
        error problem
            process.exit(2)
int64 x = int64.parse(read_input_line())
int64 s = x + 3
print("OBS=V:{s}")
print(NL)
flush()
print("ADV-END")
print(NL)
flush()
